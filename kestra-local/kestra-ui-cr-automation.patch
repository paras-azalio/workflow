+            <VersionBar
+                v-if="activity"
+                class="designer-bar"
+                :versions="versions"
+                :selected="selected"
+                :admin="me.can.admin"
+                :dirty="dirty"
+                :busy="busy"
+                :error="error"
+                :message="message"
+                :problems="problems"
+                v-on="handlers"
+            />
+        </div>
+        <KsAlert v-if="listError" type="error" :closable="false">
+            {{ listError }}
+        </KsAlert>
+        <KsEmpty v-if="!activities.length && !listError" :description="$t('cr_designer.no_activities')" />
+
+        <KsTabs v-if="config" v-model="view">
+            <KsTabPane name="form" :label="$t('cr_designer.form')">
+                <div class="config-form">
+                    <p class="hint">{{ $t("cr_designer.activity_hint") }}</p>
+                    <label class="field">
+                        <span>{{ $t("description") }}</span>
+                        <KsInput v-model="config.description" :disabled="!editable" />
+                    </label>
+
+                    <KsCard class="section" data-test="execution-section">
+                        <h5>{{ $t("cr_designer.execution") }}</h5>
+                        <p class="hint">{{ $t("cr_designer.execution_hint") }}</p>
+                        <label class="field">
+                            <span>{{ $t("cr_designer.execution_mode") }}</span>
+                            <KsSelect
+                                :modelValue="config.execution?.mode ?? ''"
+                                :placeholder="$t('cr_designer.mode_unset')"
+                                :disabled="!editable"
+                                data-test="execution-mode"
+                                @update:model-value="(m: string) => setExecution('mode', m || undefined)"
+                            >
+                                <KsOption :label="$t('cr_designer.mode_unset')" value="" />
+                                <KsOption v-for="m in MODES" :key="m" :label="$t(`cr_designer.mode_${m}`)" :value="m" />
+                            </KsSelect>
+                        </label>
+                        <div v-for="(mode, pattern) in config.execution?.nodes ?? {}" :key="pattern" class="section-head">
+                            <span>{{ $t("cr_designer.node_pattern") }}</span>
+                            <KsInput
+                                :modelValue="String(pattern)"
+                                class="pattern-input"
+                                :disabled="!editable"
+                                @change="(p: string | number) => setExecution('nodes', renameKey(config.execution.nodes, String(pattern), String(p)))"
+                            />
+                            <KsSelect
+                                :modelValue="mode"
+                                class="pattern-input"
+                                :disabled="!editable"
+                                @update:model-value="(m: string) => setExecution('nodes', {...config.execution.nodes, [pattern]: m})"
+                            >
+                                <KsOption v-for="m in MODES" :key="m" :label="$t(`cr_designer.mode_${m}`)" :value="m" />
+                            </KsSelect>
+                            <KsButton v-if="editable" :icon="Close" size="small" :aria-label="$t('delete')" @click="removeExecutionNode(String(pattern))" />
+                        </div>
+                        <KsButton v-if="editable" :icon="Plus" size="small" data-test="add-execution-node" @click="addExecutionNode">
+                            {{ $t("cr_designer.add_node_override") }}
+                        </KsButton>
+                    </KsCard>
+
+                    <KsCard v-for="(section, stepName) in config.steps" :key="stepName" class="section" :data-test="`section-${stepName}`">
+                        <div class="section-head">
+                            <span>{{ $t("cr_designer.for_step") }}</span>
+                            <KsSelect
+                                :modelValue="stepName"
+                                filterable
+                                allowCreate
+                                class="step-select"
+                                :disabled="!editable"
+                                @update:model-value="(s: string) => config.steps = renameKey(config.steps, String(stepName), s)"
+                            >
+                                <KsOption v-for="s in stepChoices" :key="s" :label="s === '*' ? $t('cr_designer.every_step') : s" :value="s" />
+                            </KsSelect>
+                            <KsButton v-if="editable" :icon="Delete" size="small" @click="removeSection(String(stepName))">
+                                {{ $t("delete") }}
+                            </KsButton>
+                        </div>
+                        <KeyValues v-for="g in GROUPS" :key="g" v-model="section[g]" :group="g" :editable="editable" :known="known(String(stepName), g)" />
+
+                        <h5>{{ $t("cr_designer.node_overrides") }}</h5>
+                        <p class="hint">{{ $t("cr_designer.node_overrides_hint") }}</p>
+                        <div v-for="(node, pattern) in section.nodes ?? {}" :key="pattern" class="node-block">
+                            <div class="section-head">
+                                <span>{{ $t("cr_designer.node_pattern") }}</span>
+                                <KsInput
+                                    :modelValue="String(pattern)"
+                                    class="pattern-input"
+                                    :disabled="!editable"
+                                    @change="(p: string | number) => section.nodes = renameKey(section.nodes, String(pattern), String(p))"
+                                />
+                                <KsButton v-if="editable" :icon="Close" size="small" :aria-label="$t('delete')" @click="removeNode(section, String(pattern))" />
+                            </div>
+                            <KeyValues v-for="g in GROUPS" :key="g" v-model="node[g]" :group="g" :editable="editable" :known="known(String(stepName), g)" />
+                        </div>
+                        <KsButton v-if="editable" :icon="Plus" size="small" @click="addNode(section)">
+                            {{ $t("cr_designer.add_node_override") }}
+                        </KsButton>
+                    </KsCard>
+                    <KsButton v-if="editable" :icon="Plus" data-test="add-section" @click="addSection">
+                        {{ $t("cr_designer.add_section") }}
+                    </KsButton>
+                </div>
+            </KsTabPane>
+            <KsTabPane name="json" :label="$t('cr_designer.json')">
+                <JsonView :value="config" :editable="editable" @apply="(v: any) => config = normalize(v)" />
+            </KsTabPane>
+        </KsTabs>
+
+        <KsDialog v-model="declaring" :title="$t('cr_designer.declare')" :beforeClose="beforeClose" width="32rem">
+            <KsForm labelPosition="top" @submit.prevent="declare">
+                <KsFormItem :label="$t('cr_designer.node_type')" required>
+                    <KsInput v-model="draft.node_type" placeholder="PGW_RDS" data-test="declare-node-type" />
+                </KsFormItem>
+                <KsFormItem :label="$t('cr_designer.sub_activity')" required>
+                    <KsInput v-model="draft.sub_activity" placeholder="1051" data-test="declare-sub-activity" />
+                </KsFormItem>
+                <KsFormItem :label="$t('description')">
+                    <KsInput v-model="draft.description" />
+                </KsFormItem>
+                <p class="hint">{{ $t("cr_designer.declare_levels_hint") }}</p>
+            </KsForm>
+            <KsAlert v-if="declareError" type="error" :closable="false">
+                {{ declareError }}
+            </KsAlert>
+            <template #footer>
+                <KsButton @click="closeDeclare">
+                    {{ $t("cancel") }}
+                </KsButton>
+                <KsButton type="primary" :disabled="!draft.node_type || !draft.sub_activity" @click="declare">
+                    {{ $t("cr_designer.declare") }}
+                </KsButton>
+            </template>
+        </KsDialog>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, onMounted, ref} from "vue"
+    import {useI18n} from "vue-i18n"
+    import Plus from "vue-material-design-icons/Plus.vue"
+    import Delete from "vue-material-design-icons/Delete.vue"
+    import Close from "vue-material-design-icons/Close.vue"
+    import VersionBar from "./VersionBar.vue"
+    import KeyValues from "./KeyValues.vue"
+    import JsonView from "./JsonView.vue"
+    import {gateway, activityUrl, renameKey, projectUrl, projects} from "./crApi"
+    import type {Me, ProjectInfo} from "./crApi"
+    import {useRoute, useRouter} from "vue-router"
+    import {useVersioned} from "./useVersioned"
+    import {useDiscardGuard} from "../../composables/useDiscardGuard"
+
+    interface Activity {node_type: string, sub_activity: string, description?: string, published_version?: number, draft_version?: number}
+
+    const GROUPS = ["params", "login", "grc"] as const
+    const MODES = ["PARALLEL", "QUEUED"] as const
+
+    const props = defineProps<{me: Me}>()
+    const {t} = useI18n()
+
+    interface Parameters {steps: Record<string, {component: string, params: Record<string, string>}>,
+                          components: Record<string, {login: Record<string, string>, grc: Record<string, string>}>}
+
+    const route = useRoute()
+    const router = useRouter()
+    const projectList = ref<ProjectInfo[]>([])
+    const project = ref("")
+    const activities = ref<Activity[]>([])
+    const parameters = ref<Parameters>({steps: {}, components: {}})
+    const knownSteps = ref<string[]>([])
+    const activity = ref<Activity>()
+    const listError = ref("")
+    const view = ref("form")
+    const declaring = ref(false)
+    const draft = ref({node_type: "", sub_activity: "", description: ""})
+    const declareError = ref("")
+
+    const keyOf = (a: Activity) => `${a.node_type} / ${a.sub_activity}`
+    const labelOf = (a: Activity) => a.node_type === "*" ? t("cr_designer.whole_project")
+        : a.sub_activity === "*" ? t("cr_designer.all_sub_activities", {nodeType: a.node_type}) : keyOf(a)
+    const activityKey = computed(() => activity.value ? keyOf(activity.value) : "")
+
+    const {versions, selected, loaded, content: config, busy, error, message, problems, dirty, loadVersions, leaveConfirmed, ask, handlers} = useVersioned({
+        base: () => activityUrl(project.value, activity.value!.node_type, activity.value!.sub_activity),
+        field: "config",
+        normalize,
+        onLoaded: () => refreshList(),
+    })
+
+    const editable = computed(() => props.me.can.admin && loaded.value?.state === "DRAFT")
+    const stepChoices = computed(() => ["*", ...knownSteps.value])
+
+    function normalize(c: any) {
+        const out = c ?? {}
+        out.steps = out.steps ?? {}
+        return out
+    }
+
+    async function refreshList() {
+        const res = await gateway<{activities: Activity[], known_steps: string[]}>(`${projectUrl(project.value)}/activities`)
+        activities.value = res.activities
+        knownSteps.value = res.known_steps
+    }
+
+    /** Another project: its own declarations, step parameters and config values. */
+    async function selectProject(p: string) {
+        if (!await leaveConfirmed()) return
+        project.value = p
+        router.replace({query: {...route.query, project: p}})
+        activity.value = undefined
+        config.value = undefined
+        await refreshList()
+        parameters.value = await gateway<Parameters>(`${projectUrl(p)}/activities/parameters`).catch(() => ({steps: {}, components: {}}))
+        if (activities.value.length) await selectActivity(keyOf(activities.value[0]))
+    }
+
+    async function selectActivity(key: string) {
+        if (!await leaveConfirmed()) return
+        activity.value = activities.value.find(a => keyOf(a) === key)
+        if (activity.value) await loadVersions()
+    }
+
+    /** What a section's group can set: the step's request parameters, or its component's login / GRC values (all for *). */
+    function known(stepName: string, group: string): Record<string, string> {
+        const steps = stepName === "*" ? Object.values(parameters.value.steps) : [parameters.value.steps[stepName]].filter(Boolean)
+        if (group === "params") return Object.assign({}, ...steps.map(s => s.params))
+        const components = stepName === "*" ? Object.keys(parameters.value.components) : steps.map(s => s.component)
+        return Object.assign({}, ...components.map(c => (parameters.value.components[c] as any)?.[group] ?? {}))
+    }
+
+    function addSection() {
+        const name = stepChoices.value.find(s => !(s in config.value.steps)) ?? `STEP_${Object.keys(config.value.steps).length + 1}`
+        config.value.steps = {...config.value.steps, [name]: {}}
+    }
+
+    async function removeSection(name: string) {
+        if (!await ask(t("cr_designer.confirm_delete_section", {step: name}))) return
+        const next = {...config.value.steps}
+        delete next[name]
+        config.value.steps = next
+    }
+
+    function setExecution(key: string, value: any) {
+        const next = {...config.value.execution}
+        if (value === undefined || (typeof value === "object" && !Object.keys(value).length)) delete next[key]
+        else next[key] = value
+        if (Object.keys(next).length) config.value.execution = next
+        else delete config.value.execution
+    }
+
+    function addExecutionNode() {
+        const nodes = config.value.execution?.nodes ?? {}
+        let n = Object.keys(nodes).length + 1
+        while (`NODE${n}*` in nodes) n++
+        setExecution("nodes", {...nodes, [`NODE${n}*`]: "QUEUED"})
+    }
+
+    function removeExecutionNode(pattern: string) {
+        const next = {...config.value.execution?.nodes}
+        delete next[pattern]
+        setExecution("nodes", next)
+    }
+
+    function addNode(section: any) {
+        let n = Object.keys(section.nodes ?? {}).length + 1
+        while (`NODE${n}*` in (section.nodes ?? {})) n++
+        section.nodes = {...section.nodes, [`NODE${n}*`]: {}}
+    }
+
+    function removeNode(section: any, pattern: string) {
+        const next = {...section.nodes}
+        delete next[pattern]
+        section.nodes = Object.keys(next).length ? next : undefined
+    }
+
+    const declareDirty = () => Object.values(draft.value).some(v => v !== "")
+    const {guardedClose} = useDiscardGuard(declareDirty)
+    const beforeClose = (done: () => void) => guardedClose(() => {
+        closeDeclare()
+        done()
+    })
+
+    function closeDeclare() {
+        declaring.value = false
+        draft.value = {node_type: "", sub_activity: "", description: ""}
+        declareError.value = ""
+    }
+
+    async function declare() {
+        if (!draft.value.node_type || !draft.value.sub_activity) return
+        try {
+            const created = await gateway<Activity>(`${projectUrl(project.value)}/activities`, {method: "POST", json: draft.value})
+            closeDeclare()
+            await refreshList()
+            await selectActivity(keyOf(created))
+        } catch (e: any) {
+            declareError.value = e?.message ?? String(e)
+        }
+    }
+
+    onMounted(async () => {
+        try {
+            const {list, first} = await projects(route.query.project)
+            projectList.value = list
+            if (first) await selectProject(first)
+        } catch (e: any) {
+            listError.value = e?.message ?? String(e)
+        }
+    })
+</script>
+
+<style scoped lang="scss">
+    .designer, .config-form {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-3);
+    }
+
+    .designer-top, .section-head {
+        display: flex;
+        flex-wrap: wrap;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .project-select {
+        width: 14rem;
+    }
+
+    .activity-select {
+        width: 22rem;
+    }
+
+    .designer-bar {
+        flex: 1;
+    }
+
+    .step-select, .pattern-input {
+        width: 16rem;
+    }
+
+    .section {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-3);
+    }
+
+    .node-block {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+        padding: var(--ks-spacing-3);
+        border: 1px solid var(--ks-border-subtle);
+        border-radius: var(--ks-spacing-1);
+    }
+
+    .field {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-1);
+        max-width: 40rem;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .hint {
+        margin: 0;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    h5 {
+        margin: 0;
+    }
+</style>
