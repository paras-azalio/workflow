+    const rows = ref<OrderRow[]>([])
+    const loading = ref(false)
+    const error = ref("")
+
+    async function load() {
+        loading.value = true
+        error.value = ""
+        const filters: Record<string, string> = {}
+        if (id.value.trim()) filters.id = id.value.trim()
