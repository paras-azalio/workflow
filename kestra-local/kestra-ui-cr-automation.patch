+    }
+
+    function connect({source, target}: {source: string, target: string}) {
+        if (source.startsWith("extra:") || target.startsWith("extra:")) return
+        const step = def.value.steps.find((s: any) => s.id === target)
+        if (step && source !== target && !step.follows.includes(source)) step.follows.push(source)
+    }
+
+    async function removeArrow(source: string, target: string) {
+        if (target.startsWith("extra:")) return
+        if (!editable.value || !await ask(t("cr_designer.confirm_remove_arrow", {from: source, to: target}))) return
+        const step = def.value.steps.find((s: any) => s.id === target)
+        step.follows = step.follows.filter((f: string) => f !== source)
+    }
+
+    function addStep() {
+        let n = def.value.steps.length + 1
+        while (def.value.steps.some((s: any) => s.id === `step_${n}`)) n++
+        const id = `step_${n}`
+        def.value.steps.push({id, label: t("cr_designer.new_step"), scope: "ORDER", runs: {flow: flows.value[0]?.id ?? ""}, inputs: {}, follows: []})
+        selectedId.value = id
+    }
+
+    function renameStep(newId: string) {
+        const oldId = selectedId.value
+        if (!oldId || !newId || newId === oldId) return
+        if (def.value.steps.some((s: any) => s.id === newId)) {
+            error.value = t("cr_designer.id_taken", {id: newId})
+            return
+        }
+        def.value.steps.forEach((s: any) => {
+            if (s.id === oldId) s.id = newId
+            s.follows = s.follows.map((f: string) => f === oldId ? newId : f)
+        })
+        if (def.value.layout[oldId]) {
+            def.value.layout[newId] = def.value.layout[oldId]
+            delete def.value.layout[oldId]
+        }
+        selectedId.value = newId
+    }
