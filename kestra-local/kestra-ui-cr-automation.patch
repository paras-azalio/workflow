+                            <KsCheckbox v-if="pending?.name.endsWith('.zip')" v-model="unzip">{{ $t("cr_designer.comp_unzip") }}</KsCheckbox>
+                            <KsButton type="primary" :disabled="!pending || uploading" data-test="component-upload-go" @click="upload">
