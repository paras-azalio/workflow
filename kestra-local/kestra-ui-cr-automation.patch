+                    <span>{{ labelOf(a) }}</span>
+                    <span class="hint">{{ a.published_version ? ` v${a.published_version}` : "" }}{{ a.draft_version ? ` · ${$t("cr_designer.draft")} v${a.draft_version}` : "" }}</span>
+                </KsOption>
