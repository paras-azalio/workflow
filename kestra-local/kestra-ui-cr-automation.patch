+            <KsTag size="small" type="info">
+                {{ $t(`cr_designer.hook_${data.hook}`) }}
+            </KsTag>
+        </div>
+        <div class="extra-label">{{ title }}</div>
+        <div class="extra-meta">{{ summary }}</div>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed} from "vue"
+    import {useI18n} from "vue-i18n"
+    import {Handle, Position} from "@vue-flow/core"
+    import {flatten} from "./pipelineWidgets"
+
+    const props = defineProps<{data: {step: string, hook: string, index: number, conditions: any[] | null, widgets: any[]}}>()
+    const {t} = useI18n()
+
+    const condition = (c: any) => c.op === "equals" ? String(c.value)
+        : c.op === "in" ? (c.value ?? []).join(` ${t("cr_designer.or")} `)
+            : `${c.ref.replace("activity.", "")} ${t(`cr_designer.op_${c.op}`)} ${Array.isArray(c.value) ? c.value.join(",") : c.value ?? ""}`
+
+    const title = computed(() => props.data.conditions
+        ? props.data.conditions.map(condition).join(" / ")
+        : t(props.data.index === 0 ? "cr_designer.every_activity" : "cr_designer.every_other_activity"))
+
+    const summary = computed(() => {
+        const all = flatten(props.data.widgets)
+        const shown = all.slice(0, 4).map(w => w.label || w.id).join(" → ")
+        return all.length > 4 ? `${shown} … (${all.length})` : shown
+    })
+</script>
+
+<style scoped lang="scss">
+    .extra-node {
+        width: 13rem;
+        padding: var(--ks-spacing-2);
+        border: 1px dashed var(--ks-border-strong);
+        border-radius: var(--ks-spacing-2);
+        background: var(--ks-bg-surface);
+        cursor: pointer;
+    }
+
+    .extra-head {
+        display: flex;
+        gap: var(--ks-spacing-1);
+    }
+
+    .extra-label {
+        margin-top: var(--ks-spacing-1);
+        font-size: var(--ks-font-size-sm);
+        font-weight: 600;
+        word-break: break-word;
+    }
+
+    .extra-meta {
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+        word-break: break-word;
+    }
+</style>
