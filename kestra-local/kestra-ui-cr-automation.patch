+                                <KsInput v-model="prm.name" :disabled="!editable" placeholder="NAME" class="pattern-input" />
+                                <KsInput v-model="prm.default" :disabled="!editable" :placeholder="$t('cr_designer.default')" class="pattern-input" />
+                                <KsInput v-model="prm.description" :disabled="!editable" :placeholder="$t('description')" class="grow" />
+                                <KsCheckbox v-model="prm.required" :disabled="!editable">{{ $t("cr_designer.required") }}</KsCheckbox>
+                                <KsButton v-if="editable" :icon="Close" size="small" :aria-label="$t('delete')" @click="a.params.splice(j, 1)" />
+                            </div>
+                            <KsButton v-if="editable" :icon="Plus" size="small" @click="a.params.push({name: '', required: false, default: '', description: ''})">
+                                {{ $t("cr_designer.comp_add_param") }}
+                            </KsButton>
+                            <strong>{{ $t("cr_designer.comp_results") }}</strong>
+                            <div v-for="(res, j) in a.results" :key="`r${j}`" class="section-head">
+                                <KsInput v-model="res.name" :disabled="!editable" placeholder="RESULT_KEY" class="pattern-input" />
+                                <KsInput v-model="res.description" :disabled="!editable" :placeholder="$t('description')" class="grow" />
+                                <KsButton v-if="editable" :icon="Close" size="small" :aria-label="$t('delete')" @click="a.results.splice(j, 1)" />
+                            </div>
+                            <KsButton v-if="editable" :icon="Plus" size="small" @click="a.results.push({name: '', description: ''})">
+                                {{ $t("cr_designer.comp_add_result") }}
+                            </KsButton>
