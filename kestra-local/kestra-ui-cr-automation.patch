+    import WidgetForm from "./WidgetForm.vue"
+    import {PIPELINE, WIDGETS, blank, flatten, nextId, renameWidget} from "./pipelineWidgets"
+
+    const TAG: Record<string, KsTagType> = {NEI: "primary", MAIL: "success", DECISION: "warning", IF: "info", FOR_EACH: "info", END: "danger"}
+
+    const props = defineProps<{list: any[]}>()
+    const ctx = inject(PIPELINE)!
+    const editable = computed(() => ctx.editable.value)
+
+    function add(type: string) {
+        props.list.push(blank(type, nextId(ctx.root.value, type)))
+    }
+
+    function move(i: number, by: number) {
+        const [w] = props.list.splice(i, 1)
+        props.list.splice(i + by, 0, w)
+    }
+
+    function remove(i: number) {
+        props.list.splice(i, 1)
+    }
+
+    function rename(w: any, to: string) {
+        if (!to || to === w.id || flatten(ctx.root.value).some(x => x.id === to)) return
+        renameWidget(ctx.root.value, w.id, to)
+    }
