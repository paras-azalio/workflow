+        def.value.steps = def.value.steps.filter((s: any) => s.id !== id)
+        def.value.steps.forEach((s: any) => s.follows = s.follows.filter((f: string) => f !== id))
+        delete def.value.layout[id]
+        selectedId.value = undefined
+    }
+
+    onMounted(async () => {
+        try {
+            const {list, first, defaultProject: fallback} = await projects(route.query.project)
+            projectList.value = list
