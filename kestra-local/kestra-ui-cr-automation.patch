+                </KsFormItem>
+            </KsForm>
+            <KsAlert v-if="declareError" type="error" :closable="false">{{ declareError }}</KsAlert>
+            <template #footer>
+                <KsButton @click="closeDeclare">{{ $t("cancel") }}</KsButton>
+                <KsButton type="primary" :disabled="!draft.name" data-test="declare-component-go" @click="declare">{{ $t("cr_designer.comp_declare") }}</KsButton>
+            </template>
+        </KsDialog>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, onMounted, reactive, ref, watch} from "vue"
+    import {useI18n} from "vue-i18n"
+    import {useRoute, useRouter} from "vue-router"
+    import Plus from "vue-material-design-icons/Plus.vue"
+    import Delete from "vue-material-design-icons/Delete.vue"
+    import Close from "vue-material-design-icons/Close.vue"
+    import Upload from "vue-material-design-icons/Upload.vue"
+    import Play from "vue-material-design-icons/Play.vue"
+    import VersionBar from "./VersionBar.vue"
+    import KeyValues from "./KeyValues.vue"
+    import JsonView from "./JsonView.vue"
+    import {gateway, projectUrl, projects, GatewayError} from "./crApi"
+    import type {Me, ProjectInfo} from "./crApi"
+    import {useVersioned} from "./useVersioned"
+    import {useDiscardGuard} from "../../composables/useDiscardGuard"
+
+    interface ComponentRow {name: string, kind?: string, description?: string, published_version?: number, draft_version?: number}
+    interface FileRow {name: string, path: string, size?: number}
+
+    const RUNTIMES = ["python3", "java", "java8", "shell"]
+    const INPUTS = ["REQUEST_FILE", "ARGS", "ENV"]
+    const OUTPUTS = ["RESPONSE_FILE", "STDOUT_KEYVALUE", "STDOUT_JSON", "EXIT_CODE"]
+
+    const props = defineProps<{me: Me}>()
+    const route = useRoute()
+    const router = useRouter()
+    const {t} = useI18n()
+
+    const projectList = ref<ProjectInfo[]>([])
+    const project = ref("")
+    const list = ref<ComponentRow[]>([])
+    const name = ref("")
+    const view = ref("form")
+    const files = ref<FileRow[]>([])
+
+    const base = () => `${projectUrl(project.value)}/components/${encodeURIComponent(name.value)}`
+    const {versions, selected, loaded, content: spec, busy, error, message, problems, dirty, loadVersions, leaveConfirmed, handlers} = useVersioned({
+        base,
+        field: "spec",
+        normalize,
+        onLoaded: async () => {
+            files.value = (loaded.value as any)?.files ?? []
+            tryResult.value = undefined
+            await refreshList()
+        },
+    })
+
+    const editable = computed(() => props.me.can.admin && loaded.value?.state === "DRAFT")
+    const dir = computed(() => (loaded.value as any)?.dir ?? "")
+
+    function normalize(s: any) {
+        const out = s ?? {}
+        out.location = out.location ?? "UPLOADED"
+        // the gateway sends JSON booleans back as text
+        const yes = (v: any) => v === true || v === "true"
+        const param = (p: any) => ({...p, required: yes(p.required), ...(p.secret !== undefined ? {secret: yes(p.secret)} : {})})
+        out.actions = (out.actions ?? []).map((a: any) => ({...a, results: a.results ?? [], params: (a.params ?? []).map(param)}))
+        if (out.kind === "WRAPPED") out.wrapped = {grc: {}, login: {}, ...(out.wrapped ?? {})}
+        else out.standalone = {runtime: "python3", command: "", input: "ARGS", output: "STDOUT_KEYVALUE", ...(out.standalone ?? {})}
+        return out
+    }
+
+    const size = (n?: number) => n === undefined ? "" : n > 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.ceil(n / 1024)} KB`
+
+    // KsInputNumber emits once on mount and the gateway sends numbers back as text: only a real change is written
+    function setTimeout(v: number | undefined) {
+        if (String(spec.value.standalone.timeout_sec ?? "") !== String(v ?? "")) spec.value.standalone.timeout_sec = v
+    }
+
+    async function refreshList() {
+        list.value = (await gateway<{components: ComponentRow[]}>(`${projectUrl(project.value)}/components`)).components
+    }
+
+    async function selectProject(p: string) {
+        if (!await leaveConfirmed()) return
+        project.value = p
+        router.replace({query: {...route.query, project: p}})
+        name.value = ""
+        spec.value = undefined
+        await refreshList()
+    }
+
+    async function selectComponent(n: string) {
+        if (!await leaveConfirmed()) return
+        name.value = n
+        await loadVersions()
+    }
+
+    // ---------------------------------------------------------------- files
+
+    const pending = ref<File>()
+    const uploadPath = ref("")
+    const unzip = ref(true)
+    const uploading = ref(false)
+    const fileError = ref("")
+    const uploadNote = ref("")
+
+    function pick(f: File) {
+        pending.value = f
+        uploadPath.value = f.name.endsWith(".zip") ? "" : f.name
+    }
+
+    async function upload() {
+        if (!pending.value) return
+        uploading.value = true
+        fileError.value = ""
+        uploadNote.value = ""
+        try {
+            const zip = pending.value.name.endsWith(".zip") && unzip.value
+            const query = new URLSearchParams({path: uploadPath.value, ...(zip ? {unzip: "true"} : {})})
+            const response = await fetch(`${base()}/versions/${selected.value}/files?${query}`, {method: "PUT", body: pending.value, credentials: "same-origin"})
+            const body = await response.json().catch(() => ({}))
+            if (!response.ok) throw new GatewayError(body.message ?? response.statusText, response.status)
+            uploadNote.value = body.dropped_folder
+                ? t("cr_designer.comp_uploaded_dropped", {count: body.written.length, folder: body.dropped_folder})
+                : t("cr_designer.comp_uploaded", {count: body.written.length})
+            pending.value = undefined
+            uploadPath.value = ""
+            await refreshFiles()
+        } catch (e: any) {
+            fileError.value = e?.message ?? String(e)
+        } finally {
+            uploading.value = false
+        }
+    }
+
+    async function removeFile(path: string) {
+        fileError.value = ""
+        try {
+            await gateway(`${base()}/versions/${selected.value}/files?${new URLSearchParams({path})}`, {method: "DELETE"})
+            await refreshFiles()
+        } catch (e: any) {
+            fileError.value = e?.message ?? String(e)
+        }
+    }
+
+    async function refreshFiles() {
+        files.value = (await gateway<{files: FileRow[]}>(`${base()}/versions/${selected.value}/files`)).files
+    }
+
+    // ---------------------------------------------------------------- try it
+
+    const tryAction = ref("")
+    const tryValues = reactive<Record<string, string>>({})
+    const tryResult = ref<any>()
+    const tryError = ref("")
+    const trying = ref(false)
+    const tryParams = computed<any[]>(() => spec.value?.actions?.find((a: any) => a.name === tryAction.value)?.params ?? [])
+
+    watch(tryParams, params => {
+        for (const p of params) if (!(p.name in tryValues)) tryValues[p.name] = p.default ?? ""
+    })
+
+    async function runTry() {
+        trying.value = true
+        tryError.value = ""
+        tryResult.value = undefined
+        try {
+            const params = Object.fromEntries(tryParams.value.map((p: any) => [p.name, tryValues[p.name] ?? ""]))
+            tryResult.value = await gateway(`${base()}/versions/${selected.value}/try`, {method: "POST", json: {action: tryAction.value, params}})
+        } catch (e: any) {
+            tryError.value = e?.message ?? String(e)
+        } finally {
+            trying.value = false
+        }
+    }
+
+    // ---------------------------------------------------------------- declare
+
+    const declaring = ref(false)
+    const draft = ref({name: "", kind: "STANDALONE", description: ""})
+    const declareError = ref("")
+    const {guardedClose} = useDiscardGuard(() => !!(draft.value.name || draft.value.description))
+    const beforeClose = (done: () => void) => guardedClose(() => {
+        closeDeclare()
+        done()
+    })
+
+    function closeDeclare() {
+        declaring.value = false
+        draft.value = {name: "", kind: "STANDALONE", description: ""}
+        declareError.value = ""
+    }
+
+    async function declare() {
+        try {
+            const made = await gateway<{name: string}>(`${projectUrl(project.value)}/components`, {method: "POST", json: draft.value})
+            closeDeclare()
+            await refreshList()
+            await selectComponent(made.name)
+        } catch (e: any) {
+            declareError.value = e?.message ?? String(e)
+        }
+    }
+
+    onMounted(async () => {
+        const {list: all, first} = await projects(route.query.project)
+        projectList.value = all
+        if (first) await selectProject(first)
+    })
+</script>
+
+<style scoped lang="scss">
+    .designer, .config-form {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-3);
+    }
+
+    .designer-top, .section-head, .field-row, .file-row {
+        display: flex;
+        flex-wrap: wrap;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .project-select {
+        width: 14rem;
+    }
+
+    .activity-select {
+        width: 20rem;
+    }
+
+    .designer-bar {
+        flex: 1;
+    }
+
+    .pattern-input {
+        width: 14rem;
+    }
+
+    .grow {
+        flex: 1;
+        min-width: 12rem;
+    }
+
+    .section {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+    }
+
+    .node-block {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+        padding: var(--ks-spacing-3);
+        border: 1px solid var(--ks-border-subtle);
+        border-radius: var(--ks-spacing-1);
+    }
+
+    .field {
+        display: flex;
+        flex: 1;
+        flex-direction: column;
+        gap: var(--ks-spacing-1);
+        min-width: 10rem;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .field.narrow {
+        flex: 0 0 10rem;
+    }
+
+    .hint {
+        margin: 0;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    .log {
+        max-height: 20rem;
+        overflow: auto;
+        margin: 0;
+        font-size: var(--ks-font-size-xs);
+        white-space: pre-wrap;
+    }
+
+    h5 {
+        margin: 0;
+    }
+</style>
