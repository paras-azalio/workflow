diff --git a/ui/src/components/crdesigner/FlowView.vue b/ui/src/components/crdesigner/FlowView.vue
new file mode 100644
index 0000000..f7b312b
--- /dev/null
+++ b/ui/src/components/crdesigner/FlowView.vue
@@ -0,0 +1,201 @@
+<template>
+    <div class="flow-view" data-test="flow-view">
+        <div class="flow-crumbs">
+            <KsButton size="small" text :disabled="!drill" data-test="flow-crumb-main" @click="drill = undefined">
+                {{ $t("cr_designer.flow_main") }}
+            </KsButton>
+            <template v-if="drill">
+                <ChevronRight />
+                <span>{{ drillStep?.label }}</span>
+                <ChevronRight />
+                <strong>{{ $t(`cr_designer.hook_${drill.hook}`) }}</strong>
+            </template>
+            <span class="hint">{{ drill ? $t("cr_designer.flow_drill_hint") : $t("cr_designer.flow_main_hint") }}</span>
+            <span class="tools">
+                <KsButton size="small" :icon="MagnifyPlusOutline" :aria-label="$t('cr_designer.flow_zoom_in')" :title="$t('cr_designer.flow_zoom_in')" @click="zoom(1)" />
+                <KsButton size="small" :icon="MagnifyMinusOutline" :aria-label="$t('cr_designer.flow_zoom_out')" :title="$t('cr_designer.flow_zoom_out')" @click="zoom(-1)" />
+                <KsButton size="small" :icon="FitToScreenOutline" :aria-label="$t('cr_designer.flow_fit')" :title="$t('cr_designer.flow_fit')" data-test="flow-fit" @click="fit" />
+                <KsButton size="small" :icon="Download" :aria-label="$t('cr_designer.flow_export')" :title="$t('cr_designer.flow_export')" data-test="flow-export" @click="exportPng" />
+            </span>
+        </div>
+        <div class="flow-canvas" :class="{split: drill}">
+            <VueFlow
+                id="cr-flow-main"
+                :nodes="toNodes(main.nodes)"
+                :edges="toEdges(main.edges)"
+                :nodesDraggable="false"
+                :nodesConnectable="false"
+                :minZoom="0.2"
+                :maxZoom="1.5"
+                @nodeClick="({node}) => pick(node.data)"
+                @nodeDoubleClick="({node}) => open(node.data)"
+                @nodesInitialized="readable(main$)"
+            >
+                <Background :gap="GRAPH_BACKGROUND.gap" :size="GRAPH_BACKGROUND.size" />
+                <template #node-flow="p">
+                    <FlowNode :data="p.data" :selected="isSelected(p.data)" />
+                </template>
+                <template #edge-insert="p">
+                    <InsertEdge v-bind="p" />
+                </template>
+            </VueFlow>
+        </div>
+        <div v-if="drill" class="flow-canvas split" data-test="flow-drill">
+            <VueFlow
+                id="cr-flow-drill"
+                :nodes="toNodes(drillGraph.nodes)"
+                :edges="toEdges(drillGraph.edges)"
+                :nodesDraggable="false"
+                :nodesConnectable="false"
+                :minZoom="0.2"
+                :maxZoom="1.5"
+                @nodeClick="({node}) => pick(node.data)"
+                @nodesInitialized="readable(drill$)"
+            >
+                <Background :gap="GRAPH_BACKGROUND.gap" :size="GRAPH_BACKGROUND.size" />
+                <template #node-flow="p">
+                    <FlowNode :data="p.data" :selected="isSelected(p.data)" />
+                </template>
+                <template #edge-insert="p">
+                    <InsertEdge v-bind="p" />
+                </template>
+            </VueFlow>
+        </div>
+        <p class="hint legend">{{ $t("cr_designer.flow_legend") }}</p>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, provide, ref, watch} from "vue"
+    import {useI18n} from "vue-i18n"
+    import {VueFlow, MarkerType, getRectOfNodes, useVueFlow} from "@vue-flow/core"
+    import {Background} from "@vue-flow/background"
+    import {GRAPH_BACKGROUND, useScreenshot} from "@kestra-io/topology"
+    import ChevronRight from "vue-material-design-icons/ChevronRight.vue"
+    import MagnifyPlusOutline from "vue-material-design-icons/MagnifyPlusOutline.vue"
+    import MagnifyMinusOutline from "vue-material-design-icons/MagnifyMinusOutline.vue"
+    import FitToScreenOutline from "vue-material-design-icons/FitToScreenOutline.vue"
+    import Download from "vue-material-design-icons/Download.vue"
+    import FlowNode from "./FlowNode.vue"
+    import InsertEdge from "./InsertEdge.vue"
+    import {FLOW_INSERT} from "./pipelineWidgets"
+    import {mainFlow, drillFlow} from "./flowGraph"
+    import type {FlowNode as Box, FlowEdge, FlowPick} from "./flowGraph"
+    import type {FlowInfo} from "./crApi"
+
+    const props = defineProps<{definition: any, flows: FlowInfo[], selected?: FlowPick, editable?: boolean}>()
+    const emit = defineEmits<{select: [pick: FlowPick], insert: [insert: NonNullable<FlowEdge["insert"]>, type: string]}>()
+
+    provide(FLOW_INSERT, (insert, type) => emit("insert", insert, type))
+    const {t} = useI18n()
+    const main$ = useVueFlow("cr-flow-main")
+    const drill$ = useVueFlow("cr-flow-drill")
+    const READABLE = 0.85
+
+    /** Fit the whole picture; when that is too small to read, start at a readable zoom from the left (pan to see more). */
+    async function readable(flow: ReturnType<typeof useVueFlow>) {
+        await flow.fitView({padding: 0.1})
+        const {y, zoom} = flow.getViewport()
+        if (zoom >= READABLE) return
+        const h = flow.dimensions.value.height
+        flow.setViewport({x: 24, y: h / 2 - (h / 2 - y) * READABLE / zoom, zoom: READABLE})
+    }
+
+    const target = () => drill.value ? drill$ : main$
+
+    const zoom = (direction: number) => direction > 0 ? target().zoomIn() : target().zoomOut()
+
+    const fit = () => target().fitView({padding: 0.1})
+
+    const {capture} = useScreenshot()
+
+    /** The whole picture of the panel shown (main flow, or the drill-down when open) as a PNG download. */
+    async function exportPng() {
+        const flow = target()
+        if (!flow.vueFlowRef.value) return
+        const name = drill.value ? `${drill.value.step}-${drill.value.hook}` : "main-flow"
+        await capture(flow.vueFlowRef.value, {type: "png", fileName: `flow-${name}`, bounds: getRectOfNodes(flow.getNodes.value), shouldDownload: true})
+    }
+
+    const drill = ref<{step: string, hook: string}>()
+    const drillStep = computed(() => props.definition?.steps?.find((s: any) => s.id === drill.value?.step))
+
+    const main = computed(() => mainFlow(props.definition, props.flows, t))
+    const drillGraph = computed(() => drill.value ? drillFlow(props.definition, props.flows, drill.value.step, drill.value.hook, t) : {nodes: [], edges: []})
+
+    watch(() => props.definition, () => {
+        if (drill.value && !drillStep.value) drill.value = undefined
+    })
+
+    const toNodes = (nodes: Box[]) => nodes.map(n => ({
+        id: n.id, type: "flow", position: {x: n.x, y: n.y}, data: n, draggable: false, connectable: false,
+        zIndex: n.kind === "group" ? 0 : 1, style: {width: `${n.w}px`, height: `${n.h}px`},
+    }))
+
+    const toEdges = (edges: FlowEdge[]) => edges.map(e => ({
+        id: e.id, source: e.source, target: e.target, sourceHandle: e.sourceHandle, targetHandle: e.targetHandle,
+        type: props.editable && e.insert ? "insert" : "smoothstep", label: e.label, markerEnd: MarkerType.ArrowClosed, zIndex: 2,
+        style: e.back ? {strokeDasharray: "5 4"} : undefined,
+        pathOptions: e.back ? {offset: 40 + 28 * (e.lane ?? 1)} : undefined,
+        labelStyle: e.label === "TRUE" ? {fill: "var(--ks-text-success)", fontWeight: 700}
+            : e.label === "FALSE" ? {fill: "var(--ks-text-error)", fontWeight: 700} : undefined,
+        labelBgStyle: {fill: "var(--ks-bg-base)"},
+        data: e,
+    }))
+
+    function pick(n: Box) {
+        if (n.step) emit("select", {step: n.step, hook: n.hook, widget: n.widget})
+    }
+
+    function open(n: Box) {
+        if (n.drill && n.step && n.hook) drill.value = {step: n.step, hook: n.hook}
+    }
+
+    const isSelected = (n: Box) => !!props.selected && n.step === props.selected.step
+        && (props.selected.widget ? n.widget === props.selected.widget : n.kind === "step")
+</script>
+
+<style scoped lang="scss">
+    .flow-view {
+        display: flex;
+        flex: 1;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+        min-width: 0;
+    }
+
+    .tools {
+        display: flex;
+        gap: var(--ks-spacing-1);
+        margin-left: auto;
+    }
+
+    .flow-crumbs {
+        display: flex;
+        gap: var(--ks-spacing-1);
+        align-items: center;
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .flow-canvas {
+        flex: 1;
+        min-height: 0;
+        border: 1px solid var(--ks-border-default);
+        border-radius: var(--ks-spacing-2);
+        background: var(--ks-bg-base);
+    }
+
+    .flow-canvas.split {
+        flex: 0 0 calc(50% - var(--ks-spacing-4));
+    }
+
+    .hint {
+        margin: 0 0 0 var(--ks-spacing-2);
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    .legend {
+        margin: 0;
+    }
+</style>
diff --git a/ui/src/components/crdesigner/FlowWidgetPanel.vue b/ui/src/components/crdesigner/FlowWidgetPanel.vue
new file mode 100644
index 0000000..dbe7923
--- /dev/null
+++ b/ui/src/components/crdesigner/FlowWidgetPanel.vue
@@ -0,0 +1,94 @@
+<template>
+    <div class="widget-panel" data-test="flow-widget-panel">
+        <div class="panel-head">
+            <KsButton size="small" text :icon="ArrowLeft" data-test="flow-widget-back" @click="emit('back')">
+                {{ stepLabel }}
+            </KsButton>
+        </div>
+        <template v-if="widget">
+            <div class="panel-head">
+                <KsTag size="small" type="info">{{ $t(`cr_designer.widget_${widget.widget}`) }}</KsTag>
+                <span class="hint">{{ $t(`cr_designer.hook_${hook}`) }}</span>
+                <KsButton v-if="editable" size="small" :icon="Delete" data-test="flow-widget-delete" class="push" @click="remove">
+                    {{ $t("delete") }}
+                </KsButton>
+            </div>
+            <label class="field">
+                <span>{{ $t("cr_designer.f_id") }}</span>
+                <KsInput :modelValue="widget.id" :disabled="!editable" @change="(v: string | number) => rename(String(v))" />
+            </label>
+            <label class="field">
+                <span>{{ $t("cr_designer.label") }}</span>
+                <KsInput v-model="widget.label" :disabled="!editable" />
+            </label>
+            <WidgetForm :widget="widget" />
+            <p v-if="widget.widget === 'IF' || widget.widget === 'FOR_EACH'" class="hint">{{ $t("cr_designer.flow_branch_hint") }}</p>
+        </template>
+        <p v-else class="hint">{{ $t("cr_designer.flow_widget_gone") }}</p>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, provide, toRef} from "vue"
+    import ArrowLeft from "vue-material-design-icons/ArrowLeft.vue"
+    import Delete from "vue-material-design-icons/Delete.vue"
+    import WidgetForm from "./WidgetForm.vue"
+    import {PIPELINE, flatten, removeWidget, renameWidget} from "./pipelineWidgets"
+
+    const props = defineProps<{step: any, hook: string, widgetId: string, editable: boolean}>()
+    const emit = defineEmits<{back: [], renamed: [id: string]}>()
+
+    const root = computed(() => props.step.pipelines?.[props.hook] ?? [])
+    const widget = computed(() => flatten(root.value).find(w => w.id === props.widgetId))
+    const stepLabel = computed(() => props.step.label || props.step.id)
+
+    provide(PIPELINE, {editable: toRef(props, "editable"), root, hook: toRef(props, "hook")})
+
+    function rename(to: string) {
+        if (!to || to === props.widgetId || flatten(root.value).some(w => w.id === to)) return
+        renameWidget(root.value, props.widgetId, to)
+        emit("renamed", to)
+    }
+
+    /** An emptied pipeline is no pipeline: the flow then runs its own default again. */
+    function remove() {
+        removeWidget(root.value, props.widgetId)
+        if (!root.value.length) {
+            delete props.step.pipelines[props.hook]
+            if (!Object.keys(props.step.pipelines).length) delete props.step.pipelines
+        }
+        emit("back")
+    }
+</script>
+
+<style scoped lang="scss">
+    .widget-panel {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
