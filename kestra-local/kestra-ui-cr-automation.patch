+        delete def.value.layout[id]
+        selectedId.value = undefined
+    }
+
+    onMounted(async () => {
+        try {
+            const [list, ctx] = await Promise.all([
+                gateway<{processes: {project: string}[]}>("/cr/api/processes"),
+                gateway<{order: string[], child: string[]}>("/cr/api/context-fields"),
+            ])
+            projects.value = list.processes
+            fields.value = ctx
+            project.value = list.processes[0]?.project ?? ""
+            if (project.value) await loadVersions()
+        } catch (e: any) {
+            error.value = e?.message ?? String(e)
+        }
+    })
+</script>
