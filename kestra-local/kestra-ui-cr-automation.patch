+++ b/ui/src/utils/requestId.ts
@@ -0,0 +1,8 @@
+/**
+ * cr_automation: the request id of an execution - the whole number (1, 2, 3, ...) the flows give every order and
+ * child order (bin/req_id.py) and put in the label `req_id`. Shown instead of Kestra's own execution id, which
+ * Kestra generates and cannot be changed; undefined when the execution has no such label.
+ */
+export function requestId(execution?: {labels?: {key?: string; value?: string}[] | null}): string | undefined {
+    return execution?.labels?.find((l) => l.key === "req_id")?.value ?? undefined
+}
