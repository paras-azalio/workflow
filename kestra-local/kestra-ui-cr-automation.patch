+<template>
+    <div class="pipeline-editor" data-test="pipeline-editor">
+        <p class="hint">{{ $t(`cr_designer.hook_${hook}_hint`) }}</p>
+        <KsCollapse>
+            <KsCollapseItem :title="$t('cr_designer.references')">
+                <ul class="refs">
+                    <li v-for="r in references" :key="r[0]">
+                        <code>{{ r[0] }}</code> {{ $t(`cr_designer.ref_${r[1]}`) }}
+                    </li>
+                </ul>
+            </KsCollapseItem>
+        </KsCollapse>
+        <WidgetList :list="widgets" />
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, provide, toRef} from "vue"
+    import WidgetList from "./WidgetList.vue"
+    import {PIPELINE} from "./pipelineWidgets"
+
+    const props = defineProps<{widgets: any[], hook: string, editable: boolean}>()
+
+    provide(PIPELINE, {editable: toRef(props, "editable"), root: toRef(props, "widgets"), hook: toRef(props, "hook")})
+
+    const references = computed(() => [
+        ["${order.NAME} ${child.NAME}", "context"],
+        ["${ciq.NAME}", "ciq"],
+        ["${activity.node_type} ${activity.sub_activity}", "activity"],
+        ...(props.hook === "node" ? [["${node}", "node"]] : [["${run.failed_nodes} ${run.succeeded_nodes}", "run"]]),
+        ["${item}", "item"],
+        ["${step.ID.NAME}", "step"],
+        ["${secret:NAME} ${WORKDIR}", "secret"],
+    ])
+</script>
+
+<style scoped lang="scss">
+    .pipeline-editor {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-3);
+    }
+
+    .hint {
+        margin: 0;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .refs {
+        margin: 0;
+        padding-left: var(--ks-spacing-5);
+        font-size: var(--ks-font-size-sm);
+    }
+</style>
