new file mode 100644
index 0000000..6974aeb
--- /dev/null
+++ b/ui/src/components/crdesigner/crApi.ts
@@ -0,0 +1,78 @@
+/**
+ * The cr_automation gateway's API (/cr/api) and the Kestra calls the designer needs. The gateway enforces the
+ * roles; the UI only avoids offering what the role cannot do.
+ */
+
+export interface Me {username: string, role: string, can: {view: boolean, execute: boolean, admin: boolean}}
+
+export interface VersionSummary {version: number, state: "DRAFT" | "PUBLISHED" | "RETIRED", revision: number}
+
+export interface ProcessVersion extends VersionSummary {project: string, definition: any, problems: string[]}
+
+export interface ActivityVersion extends VersionSummary {node_type: string, sub_activity: string, config: any, problems: string[]}
+
+/** `hooks`: the pipelines a step may attach to the flow (its label pipeline_hooks); `labels`: all its labels (e.g. outline). */
+export interface FlowInfo {id: string, inputs: {id: string, type: string}[], hooks: string[], labels?: Record<string, string>}
+
+export class GatewayError extends Error {
+    constructor(message: string, public status: number, public problems: string[] = []) {
+        super(message)
+    }
+}
+
+export async function gateway<T = any>(path: string, init?: RequestInit & {json?: unknown}): Promise<T> {
+    const {json, ...rest} = init ?? {}
+    const response = await fetch(path, {
+        credentials: "same-origin",
+        ...rest,
+        ...(json === undefined ? {} : {body: JSON.stringify(json), headers: {"Content-Type": "application/json"}}),
+    })
+    const body = await response.json().catch(() => ({}))
+    if (!response.ok) throw new GatewayError(body?.message ?? response.statusText, response.status, body?.problems ?? [])
+    return body as T
+}
+
+export const processUrl = (project: string) => `/cr/api/processes/${encodeURIComponent(project)}`
+/** A project's own API routes (its activities, its designer field names). */
+export const projectUrl = (project: string) => `/cr/api/projects/${encodeURIComponent(project)}`
+
+export const activityUrl = (project: string, nodeType: string, subActivity: string) =>
+    `${projectUrl(project)}/activities/${encodeURIComponent(nodeType)}/${encodeURIComponent(subActivity)}`
+
+export interface ProjectInfo {project: string, name?: string, namespace?: string, hidden_at?: string}
+
+/**
+ * The projects (with the deleted ones when `withDeleted`), the gateway's default project, and the one to show first:
+ * the route's ?project=, else the default one.
+ */
+export async function projects(wanted?: unknown, withDeleted = false): Promise<{list: ProjectInfo[], first: string, defaultProject?: string}> {
+    const res = await gateway<{processes: ProjectInfo[], default_project?: string}>(`/cr/api/processes${withDeleted ? "?hidden=true" : ""}`)
+    const names = res.processes.map(p => p.project)
+    const first = typeof wanted === "string" && names.includes(wanted) ? wanted
+        : res.default_project && names.includes(res.default_project) ? res.default_project : names[0] ?? ""
+    return {list: res.processes, first, defaultProject: res.default_project}
+}
+
+/** The flows of a namespace a process step may run: those labelled process: "true", with their declared inputs. */
+export async function processFlows(tenant: string, namespace: string): Promise<FlowInfo[]> {
+    const flows = await gateway<any[]>(`/api/v1/${tenant}/flows/${encodeURIComponent(namespace)}`)
+    return flows
+        .filter(f => (f.labels ?? []).some((l: any) => l.key === "process" && String(l.value) === "true"))
+        .map(f => ({
+            id: f.id,
+            inputs: (f.inputs ?? []).map((i: any) => ({id: i.id, type: i.type})),
+            hooks: String((f.labels ?? []).find((l: any) => l.key === "pipeline_hooks")?.value ?? "").split(",").map(h => h.trim()).filter(Boolean),
+            labels: Object.fromEntries((f.labels ?? []).map((l: any) => [l.key, String(l.value)])),
+        }))
+}
+
+export function clone<T>(value: T): T {
+    return JSON.parse(JSON.stringify(value ?? null))
+}
+
+/** The object with one key renamed, keeping the key order; unchanged when the new key is empty or taken. */
+export function renameKey<T>(object: Record<string, T> | undefined, from: string, to: string): Record<string, T> {
+    const entries = Object.entries(object ?? {})
+    if (!to || to === from || entries.some(([k]) => k === to)) return object ?? {}
+    return Object.fromEntries(entries.map(([k, v]) => [k === from ? to : k, v]))
+}
diff --git a/ui/src/components/crdesigner/flowGraph.ts b/ui/src/components/crdesigner/flowGraph.ts
new file mode 100644
index 0000000..841540d
--- /dev/null
+++ b/ui/src/components/crdesigner/flowGraph.ts
@@ -0,0 +1,423 @@
+import type {FlowInfo} from "./crApi"
+
+/**
+ * The Flow view's picture, built from the process data only: the steps (ranked by `follows`, START to END), each
+ * with the person's wait or its automatic start, its `available_when` as an If, the flow's own work (its `outline`
+ * label) and its pipelines; a pipeline is drawn from its widget tree (If = TRUE straight on, FALSE below, both
+ * meeting again; For each = a group). Positions are computed here; nothing is placed by hand.
+ */
+
+export type Kind = "start" | "end" | "fail" | "step" | "nei" | "mail" | "wait" | "person" | "if" | "collect"
+    | "each" | "report" | "merge" | "group"
+
+export interface FlowNode {
+    id: string
+    kind: Kind
+    title: string
+    sub?: string
+    tag?: string
+    x: number
+    y: number
+    w: number
+    h: number
+    /** What a click opens: the step, a hook's pipeline, a widget of it; `drill` = the box opens the hook's drill-down. */
+    step?: string
+    hook?: string
+    widget?: string
+    drill?: boolean
+}
+
+export interface FlowEdge {
+    id: string
+    source: string
+    target: string
+    sourceHandle: string
+    targetHandle: string
+    label?: string
+    back?: boolean
+    /** A back arrow's lane below the flow (1, 2, ...), so two of them never share a line. */
+    lane?: number
+    /** Where a new widget goes when it is inserted on this arrow (G2): the list and the index in it. */
+    insert?: {step: string, hook: string, path: (string | number)[], index: number}
+}
+
+/** What a click on a box selects: its step, and the hook and widget when it is part of a pipeline. */
+export interface FlowPick {step?: string, hook?: string, widget?: string}
+
+export interface Graph {
+    nodes: FlowNode[]
+    edges: FlowEdge[]
+}
+
+type T = (key: string, values?: Record<string, unknown>) => string
+
+const SIZE: Record<string, {w: number, h: number}> = {
+    box: {w: 176, h: 60}, if: {w: 64, h: 64}, merge: {w: 12, h: 12}, circle: {w: 40, h: 40},
+}
+const GAP_X = 52
+const GAP_Y = 48
+const PAD = 18
+const HEAD = 24
+
+interface Exit {id: string, handle: string, label?: string, insert?: FlowEdge["insert"]}
+
+interface Block {
+    nodes: FlowNode[]
+    edges: FlowEdge[]
+    w: number
+    h: number
+    cy: number
+    entry?: string
+    exits: Exit[]
+    /** The insert point of the arrow that enters this block (the start of a pipeline list). */
+    insertBefore?: FlowEdge["insert"]
+}
+
+interface Ctx {
+    t: T
+    next: () => string
+    step?: string
+    hook?: string
+}
+
+const EMPTY: Block = {nodes: [], edges: [], w: 0, h: 0, cy: 0, exits: []}
+
+function size(kind: Kind) {
+    if (kind === "if") return SIZE.if
+    if (kind === "merge") return SIZE.merge
+    if (kind === "start" || kind === "end" || kind === "fail" || kind === "person") return SIZE.circle
+    return SIZE.box
+}
+
+function leaf(ctx: Ctx, kind: Kind, title: string, extra: Partial<FlowNode> = {}): Block {
+    const {w, h} = size(kind)
+    const id = ctx.next()
+    const node: FlowNode = {id, kind, title, x: 0, y: 0, w, h, step: ctx.step, hook: ctx.hook, ...extra}
+    const terminal = kind === "end" || kind === "fail"
+    return {nodes: [node], edges: [], w, h, cy: h / 2, entry: id, exits: terminal ? [] : [{id, handle: "r"}]}
+}
+
+function shift(b: Block, dx: number, dy: number) {
+    b.nodes.forEach(n => {
+        n.x += dx
+        n.y += dy
+    })
+}
+
+function connect(exit: Exit, target: string, targetHandle = "l"): FlowEdge {
+    return {id: `${exit.id}>${target}`, source: exit.id, sourceHandle: exit.handle, target, targetHandle, label: exit.label, insert: exit.insert}
+}
+
+/** Blocks left to right on one line; the exits of each lead to the next. */
+function seq(blocks: Block[], insertAt?: (index: number) => FlowEdge["insert"]): Block {
+    const list = blocks.filter(b => b.nodes.length)
+    if (!list.length) return {...EMPTY, nodes: [], edges: [], exits: []}
+    const cy = Math.max(...list.map(b => b.cy))
+    const out: Block = {nodes: [], edges: [], w: 0, h: 0, cy, exits: []}
+    let x = 0
+    let previous: Exit[] | undefined
+    list.forEach((b, i) => {
+        shift(b, x, cy - b.cy)
+        out.nodes.push(...b.nodes)
+        out.edges.push(...b.edges)
+        out.entry = out.entry ?? b.entry
+        out.insertBefore = out.insertBefore ?? b.insertBefore
+        if (previous && b.entry) {
+            const insert = b.insertBefore ?? insertAt?.(i)
+            previous.forEach(e => out.edges.push(connect({...e, insert: e.insert ?? insert}, b.entry!)))
+        }
+        previous = b.exits
+        out.h = Math.max(out.h, cy - b.cy + b.h)
+        x += b.w + GAP_X
+    })
+    out.w = x - GAP_X
+    out.exits = previous ?? []
+    return out
+}
+
+/** If: TRUE straight on, FALSE below; both meet again in a dot unless both end the pipeline. */
+function ifBlock(ctx: Ctx, diamond: Block, then: Block, otherwise: Block, inserts?: {then?: FlowEdge["insert"], else?: FlowEdge["insert"], after?: FlowEdge["insert"]}): Block {
+    const d = diamond.nodes[0]
+    const hasThen = then.nodes.length > 0
+    const hasElse = otherwise.nodes.length > 0
+    const cy = Math.max(d.h / 2, hasThen ? then.cy : 0)
+    shift(diamond, 0, cy - d.h / 2)
+    const left = d.w + GAP_X
+    if (hasThen) shift(then, left, cy - then.cy)
+    const top = Math.max(cy + d.h / 2, hasThen ? cy - then.cy + then.h : 0)
+    if (hasElse) shift(otherwise, left, top + GAP_Y)
+    const body = Math.max(then.w, otherwise.w, 40)
+    const open = !hasThen || then.exits.length > 0 || !hasElse || otherwise.exits.length > 0
+    const out: Block = {nodes: [...diamond.nodes, ...then.nodes, ...otherwise.nodes], edges: [...then.edges, ...otherwise.edges],
+        w: left + body, h: hasElse ? top + GAP_Y + otherwise.h : top + GAP_Y / 2, cy, entry: d.id, exits: []}
+    const t = {id: d.id, handle: "r", label: "TRUE", insert: inserts?.then}
+    const f = {id: d.id, handle: "b", label: "FALSE", insert: inserts?.else}
+    let merge: FlowNode | undefined
+    if (open) {
+        const m = leaf(ctx, "merge", "", {step: ctx.step, hook: ctx.hook})
+        merge = m.nodes[0]
+        merge.x = left + body + GAP_X
+        merge.y = cy - merge.h / 2
+        out.nodes.push(merge)
+        out.w = merge.x + merge.w
+        out.exits = [{id: merge.id, handle: "r", insert: inserts?.after}]
+    }
+    if (hasThen) out.edges.push(connect(t, then.entry!))
+    else if (merge) out.edges.push(connect(t, merge.id))
+    if (hasElse) out.edges.push(connect(f, otherwise.entry!))
+    else if (merge) out.edges.push(connect(f, merge.id, "tb"))
+    if (merge) {
+        then.exits.forEach(e => out.edges.push(connect(e, merge!.id)))
+        otherwise.exits.forEach(e => out.edges.push(connect(e, merge!.id, "tb")))
+    }
+    return out
+}
+
+/** A dashed group around a block (For each, or a step that runs once per value). */
+function group(ctx: Ctx, title: string, inner: Block, extra: Partial<FlowNode> = {}): Block {
+    shift(inner, PAD, HEAD + PAD)
+    const g: FlowNode = {id: ctx.next(), kind: "group", title, x: 0, y: 0, w: inner.w + 2 * PAD, h: inner.h + HEAD + 2 * PAD,
+        step: ctx.step, hook: ctx.hook, ...extra}
+    return {nodes: [g, ...inner.nodes], edges: inner.edges, w: g.w, h: g.h, cy: inner.cy + HEAD + PAD, entry: inner.entry, exits: inner.exits}
+}
+
+// ---------------------------------------------------------------- texts
+
+/** ${ciq.REPORT_EMAIL} -> CIQ REPORT_EMAIL, ${run.X} -> X, ${step.a.b} -> a's b: references as a person reads them. */
+export function human(text: string | undefined, max = 46): string {
+    const s = String(text ?? "").replace(/\$\{([^}]*)\}/g, (_, r: string) => {
+        const p = r.trim().split(".")
+        if (p[0] === "ciq") return `CIQ ${p[1]}`
+        if (p[0] === "run" || p[0] === "activity") return p[1] ?? ""
+        if (p[0] === "order" || p[0] === "child") return `${p[0]} ${p[1]}`
+        if (p[0] === "step") return `${p[1]}'s ${p[2]}`
+        if (p[0].startsWith("secret:")) return "(secret)"
+        return p[0]
+    }).replace(/\s+/g, " ").trim()
+    return s.length > max ? s.slice(0, max - 1) + "…" : s
+}
+
+function conditionText(t: T, conditions: any[]): string {
+    return (conditions ?? []).map((c: any) => {
+        const values = Array.isArray(c.value) ? c.value : c.value === undefined ? [] : [c.value]
+        if (String(c.ref).startsWith("activity.") && (c.op === "equals" || c.op === "in")) return values.join(` ${t("cr_designer.or")} `)
+        return `${human("${" + c.ref + "}", 30)} ${t(`cr_designer.op_${c.op}`)} ${values.join(", ")}`.trim()
+    }).join(` ${t("cr_designer.and")} `) + "?"
+}
+
+function availability(t: T, when: Record<string, any>): string {
+    return Object.entries(when ?? {}).map(([path, op]: [string, any]) => {
+        const [operator, operand] = Object.entries(op ?? {})[0] ?? ["non_empty", true]
+        const what = path.split(".").slice(1).join(" ").replace(/_/g, " ")
+        const value = Array.isArray(operand) ? operand.join(` ${t("cr_designer.or")} `) : operator === "equals" ? String(operand) : ""
+        return `${what} ${t(`cr_designer.when_${operator}`)} ${value}`.trim()
+    }).join(` ${t("cr_designer.and")} `) + "?"
+}
+
+function duration(iso: string | undefined): string {
+    const m = /^P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?$/.exec(String(iso ?? ""))
+    if (!m) return String(iso ?? "")
+    return [[m[1], "d"], [m[2], "h"], [m[3], "min"], [m[4], "s"]].filter(([n]) => n).map(([n, u]) => `${n} ${u}`).join(" ")
+}
+
+// ---------------------------------------------------------------- pipelines
+
+/** A list of widgets as a block; `path` is where the list sits in the hook's tree (for inserting on its arrows). */
+function widgets(ctx: Ctx, list: any[], path: (string | number)[]): Block {
+    const blocks = (list ?? []).map((w, i) => widget(ctx, w, [...path, i]))
+    const insert = (index: number) => ctx.step && ctx.hook ? {step: ctx.step, hook: ctx.hook, path, index} : undefined
+    const out = seq(blocks, insert)
+    out.insertBefore = insert(0)
+    out.exits = out.exits.map(e => ({...e, insert: e.insert ?? insert(blocks.length)}))
+    return out
+}
+
+function widget(ctx: Ctx, w: any, path: (string | number)[]): Block {
+    const t = ctx.t
+    const at = {widget: w.id}
+    switch (w.widget) {
+    case "NEI": return leaf(ctx, "nei", w.label || w.step || w.action, {...at,
+        sub: `${String(w.component ?? "").toUpperCase()} · ${w.step ?? w.action}${w.on_failure === "CONTINUE" ? " · " + t("cr_designer.flow_goes_on") : ""}`})
+    case "MAIL": return leaf(ctx, "mail", w.label || t("cr_designer.widget_MAIL"), {...at, sub: `${t("cr_designer.flow_to")} ${human(w.to, 34)}`})
+    case "DECISION": return leaf(ctx, "wait", w.label || human(w.question, 40), {...at,
+        sub: w.mode === "REPLY" ? t("cr_designer.flow_reply", {mail: w.reply_to, max: duration(w.timeout)})
+            : t("cr_designer.flow_person", {max: duration(w.timeout)})})
+    case "COLLECT": return leaf(ctx, "collect", w.label || t("cr_designer.widget_COLLECT"), {...at, sub: `${t("cr_designer.flow_into")} ${w.list}`})
+    case "END": return leaf(ctx, w.status === "SUCCESS" ? "end" : "fail",
+        w.label || (w.status === "SUCCESS" ? t("cr_designer.flow_end") : t("cr_designer.flow_end_failed")), {...at, sub: human(w.message, 40)})
+    case "IF": {
+        const list = path.slice(0, -1)
+        const index = Number(path[path.length - 1])
+        const ins = ctx.step && ctx.hook ? {
+            then: {step: ctx.step, hook: ctx.hook, path: [...path, "then"], index: 0},
+            else: {step: ctx.step, hook: ctx.hook, path: [...path, "else"], index: 0},
+            after: {step: ctx.step, hook: ctx.hook, path: list, index: index + 1},
+        } : undefined
+        return ifBlock(ctx, leaf(ctx, "if", w.label || conditionText(t, w.conditions), at),
+            widgets(ctx, w.then, [...path, "then"]), widgets(ctx, w.else, [...path, "else"]), ins)
+    }
+    case "FOR_EACH": {
+        const inner = seq([leaf(ctx, "each", w.label || t("cr_designer.widget_FOR_EACH"), {...at, sub: human(w.items, 36)}),
+            widgets(ctx, w.body, [...path, "body"])])
+        const how = Number(w.concurrency ?? 1) === 0 ? t("cr_designer.flow_all_at_once") : t("cr_designer.flow_at_a_time", {n: w.concurrency ?? 1})
+        return group(ctx, `↻ ${how}`, inner, at)
+    }
+    default: return leaf(ctx, "nei", w.label || w.id, at)
+    }
+}
+
+// ---------------------------------------------------------------- outlines (the flows' own work)
+
+/** The flow's label: "A | @node B | after_nodes | node=C | ?D" as items. */
+function outline(flow: FlowInfo | undefined, key = "outline"): string[] {
+    return String(flow?.labels?.[key] ?? "").split("|").map(s => s.trim()).filter(Boolean)
+}
+
+const kindOf = (text: string): Kind => /report/i.test(text) ? "report" : "nei"
+
+function outlineItems(ctx: Ctx, step: any, items: string[]): Block[] {
+    const out: Block[] = []
+    for (let i = 0; i < items.length; i++) {
+        const item = items[i]
+        const hookCtx = (hook: string) => ({...ctx, hook})
+        if (item.startsWith("@")) {
+            const [hook, ...rest] = item.slice(1).split(" ")
+            out.push(leaf(hookCtx(hook), "each", rest.join(" "), {drill: true, sub: ctx.t("cr_designer.flow_open")}))
+        } else if (item.startsWith("?")) {
+            const rest = seq(outlineItems(ctx, step, items.slice(i + 1)))
+            out.push(ifBlock(ctx, leaf(ctx, "if", item.slice(1)), rest, EMPTY))
+            break
+        } else if (item.includes("=") && /^[a-z_]+=/.test(item)) {
+            const [hook, text] = [item.slice(0, item.indexOf("=")), item.slice(item.indexOf("=") + 1)]
+            const pipeline = step.pipelines?.[hook]
+            if (pipeline?.length) {
+                out.push(widgets(hookCtx(hook), pipeline, []))
+            } else {
+                const box = leaf(hookCtx(hook), kindOf(text), text, {sub: ctx.t("cr_designer.flow_default")})
+                const at = (index: number) => ctx.step ? {step: ctx.step, hook, path: [], index} : undefined
+                box.insertBefore = at(0)
+                box.exits = box.exits.map(e => ({...e, insert: at(1)}))
+                out.push(box)
+            }
+        } else if (/^[a-z_]+$/.test(item)) {
+            const pipeline = step.pipelines?.[item]
+            if (pipeline?.length) out.push(widgets(hookCtx(item), pipeline, []))
+        } else {
+            out.push(leaf(ctx, kindOf(item), item.replace(/\s*\(([^)]*)\)$/, ""), {sub: /\(([^)]*)\)$/.exec(item)?.[1]}))
+        }
+    }
+    return out
+}
+
+// ---------------------------------------------------------------- the main flow
+
+function counter(prefix: string) {
+    let n = 0
+    return () => `${prefix}${n++}`
+}
+
+/** One step: who starts it, when it is offered, the step, the flow's work; a step that runs per value is grouped. */
+function chain(t: T, next: () => string, step: any, flow: FlowInfo | undefined, pending: {from: string, to: string}[]): Block {
+    const ctx: Ctx = {t, next, step: step.id}
+    const tag = step.starts_order ? t("cr_designer.starts_order") : undefined
+    // the flow's first own work describes the step's box; the rest of its outline follows as boxes
+    const items = outline(flow)
+    const first = items[0] && !/^[@?]/.test(items[0]) && !/^[a-z_]+(=|$)/.test(items[0]) ? items[0] : undefined
+    const body = seq([leaf(ctx, "step", step.label, {sub: first ?? step.runs?.flow, tag}),
+        ...outlineItems(ctx, step, first ? items.slice(1) : items)])
+    const forEach = step.auto_start?.for_each
+    const work = step.auto_start
+        ? group(ctx, forEach ? `↻ ${t("cr_designer.flow_for_each_value", {input: step.inputs?.[forEach]?.label ?? forEach})}` : t("cr_designer.auto_start"), body)
+        : body
+    const parts: Block[] = []
+    if (!step.starts_order && !step.auto_start) parts.push(leaf(ctx, "person", t("cr_designer.flow_person_starts"), {sub: t("cr_designer.flow_order_tab")}))
+    if (Object.keys(step.available_when ?? {}).length) {
+        const diamond = leaf(ctx, "if", availability(t, step.available_when))
+        const d = diamond.nodes[0]
+        if (step.otherwise) pending.push({from: d.id, to: step.otherwise})
+        const cy = Math.max(d.h / 2, work.cy)
+        shift(diamond, 0, cy - d.h / 2)
+        shift(work, d.w + GAP_X, cy - work.cy)
+        parts.push({nodes: [...diamond.nodes, ...work.nodes], edges: [connect({id: d.id, handle: "r", label: "TRUE"}, work.entry!), ...work.edges],
+            w: d.w + GAP_X + work.w, h: Math.max(d.h, work.h, cy + d.h / 2 + GAP_Y / 2), cy, entry: d.id, exits: work.exits})
+    } else {
+        parts.push(work)
+    }
+    return seq(parts)
+}
+
+export function mainFlow(def: any, flows: FlowInfo[], t: T): Graph {
+    const next = counter("m")
+    const steps: any[] = def?.steps ?? []
+    const pending: {from: string, to: string}[] = []
+    const chains = new Map<string, Block>()
+    steps.forEach(s => chains.set(s.id, chain(t, next, s, flows.find(f => f.id === s.runs?.flow), pending)))
+
+    const ids = steps.map(s => s.id)
+    const preds = new Map<string, string[]>(ids.map(id => [id, (steps.find(s => s.id === id).follows ?? []).filter((f: string) => ids.includes(f) && f !== id)]))
+    const rank = new Map<string, number>()
+    const rankOf = (id: string, seen = new Set<string>()): number => {
+        if (rank.has(id)) return rank.get(id)!
+        if (seen.has(id)) return 0
+        seen.add(id)
+        const r = Math.max(-1, ...preds.get(id)!.map(p => rankOf(p, seen))) + 1
+        rank.set(id, r)
+        return r
+    }
+    ids.forEach(id => rankOf(id))
+    const columns: string[][] = []
+    ids.forEach(id => (columns[rank.get(id)!] = columns[rank.get(id)!] ?? []).push(id))
+
+    const ctx: Ctx = {t, next}
+    const start = leaf(ctx, "start", t("cr_designer.flow_start"))
+    const nodes: FlowNode[] = []
+    const edges: FlowEdge[] = []
+    let x = start.w + GAP_X
+    let height = 0
+    columns.forEach(col => {
+        let y = 0
+        const width = Math.max(...col.map(id => chains.get(id)!.w))
+        col.forEach(id => {
+            const b = chains.get(id)!
+            shift(b, x, y)
+            nodes.push(...b.nodes)
+            edges.push(...b.edges)
+            y += b.h + GAP_Y
+        })
+        height = Math.max(height, y - GAP_Y)
+        x += width + GAP_X * 1.5
+    })
+    shift(start, 0, (chains.get(columns[0]?.[0] ?? "")?.cy ?? 0) - start.cy)
+    nodes.unshift(...start.nodes)
+    const succ = new Set<string>()
+    steps.forEach(s => preds.get(s.id)!.forEach(p => succ.add(p)))
+    steps.forEach(s => {
+        const b = chains.get(s.id)!
+        if (!preds.get(s.id)!.length) edges.push(connect(start.exits[0], b.entry!))
+        preds.get(s.id)!.forEach(p => chains.get(p)!.exits.forEach(e => edges.push({...connect(e, b.entry!), id: `${e.id}>${b.entry}:${s.id}`})))
+    })
+    const end = leaf(ctx, "end", t("cr_designer.flow_end"))
+    shift(end, x, height / 2 - end.cy)
+    nodes.push(...end.nodes)
+    steps.filter(s => !succ.has(s.id)).forEach(s => chains.get(s.id)!.exits.forEach(e => edges.push(connect(e, end.entry!))))
+    pending.forEach((p, i) => {
+        const target = chains.get(p.to)
+        if (target?.entry) {
+            edges.push({id: `${p.from}>${target.entry}:else`, source: p.from, sourceHandle: "b", target: target.entry, targetHandle: "tb",
+                label: "FALSE", back: true, lane: i + 1})
+        }
+    })
+    return {nodes, edges}
+}
+
+/** A drill-down: what runs per node (the flow's outline_<hook>, with the step's pipeline in it), from start to done. */
+export function drillFlow(def: any, flows: FlowInfo[], stepId: string, hook: string, t: T): Graph {
+    const step = (def?.steps ?? []).find((s: any) => s.id === stepId)
+    if (!step) return {nodes: [], edges: []}
+    const flow = flows.find(f => f.id === step.runs?.flow)
+    const ctx: Ctx = {t, next: counter("d"), step: stepId, hook}
+    const items = outline(flow, `outline_${hook}`)
+    const middle = items.length ? outlineItems(ctx, step, items) : [widgets(ctx, step.pipelines?.[hook] ?? [], [])]
+    const all = seq([leaf(ctx, "start", t(`cr_designer.flow_drill_start_${hook}`)), ...middle, leaf(ctx, "end", t("cr_designer.flow_drill_done"))])
+    return {nodes: all.nodes, edges: all.edges}
+}
diff --git a/ui/src/components/crdesigner/pipelineWidgets.ts b/ui/src/components/crdesigner/pipelineWidgets.ts
new file mode 100644
index 0000000..51529db
--- /dev/null
+++ b/ui/src/components/crdesigner/pipelineWidgets.ts
@@ -0,0 +1,147 @@
+import type {InjectionKey, Ref} from "vue"
+
+/** The widgets of a pipeline, as the gateway's Pipeline class accepts them. */
+export const WIDGETS = ["NEI", "MAIL", "DECISION", "IF", "FOR_EACH", "COLLECT", "END"] as const
+
+export interface PipelineContext {
+    editable: Ref<boolean>
+    root: Readonly<Ref<any[]>>
+    hook: Ref<string>
+}
+
+export const PIPELINE: InjectionKey<PipelineContext> = Symbol("cr-pipeline")
+
+/** What a NEI / Call component box can call: the built-in NEI folders and the project's registered components. */
+export interface Callables {builtins: string[], components: {name: string, kind?: string, actions: any[]}[]}
+
+export const CALLABLES: InjectionKey<Ref<Callables>> = Symbol("cr-callables")
+
+const PREFIX: Record<string, string> = {
+    NEI: "nei", MAIL: "mail", DECISION: "decision", IF: "check", FOR_EACH: "each", COLLECT: "collect", END: "end",
+}
+
+export function blank(type: string, id: string): any {
+    switch (type) {
+    case "NEI": return {id, widget: type, component: "clicr", action: "MOP_EXECUTION", params: {}}
+    case "MAIL": return {id, widget: type, to: "", subject: ""}
+    case "DECISION": return {id, widget: type, mode: "MANUAL", question: "", options: ["APPROVED", "REJECTED"], timeout: "P1D"}
+    case "IF": return {id, widget: type, conditions: [{ref: "activity.sub_activity", op: "equals", value: ""}], then: [], else: []}
+    case "FOR_EACH": return {id, widget: type, items: "", concurrency: 1, body: []}
+    case "COLLECT": return {id, widget: type, list: "", value: ""}
+    default: return {id, widget: type, status: "FAILED", message: ""}
+    }
+}
+
+/** Every widget, nested ones included (a MAIL's body is text, only a FOR_EACH's body holds widgets). */
+export function flatten(list: any[]): any[] {
+    return (list ?? []).flatMap(w => w.widget === "IF" ? [w, ...flatten(w.then), ...flatten(w.else)]
+        : w.widget === "FOR_EACH" ? [w, ...flatten(w.body)] : [w])
+}
+
+export function nextId(root: any[], type: string): string {
+    const taken = new Set(flatten(root).map(w => w.id))
+    let n = 1
+    while (taken.has(`${PREFIX[type]}_${n}`)) n++
+    return `${PREFIX[type]}_${n}`
+}
+
+/** Gives every If / For each the lists the editor fills in place. */
+export function normalize(list: any[]): any[] {
+    for (const w of list ?? []) {
+        if (w.widget === "IF") {
+            w.then = normalize(w.then ?? [])
+            w.else = normalize(w.else ?? [])
+            w.conditions = w.conditions ?? []
+        } else if (w.widget === "FOR_EACH") {
+            w.body = normalize(w.body ?? [])
+        }
+    }
+    return list ?? []
+}
+
+/** Renames a widget and every reference to it (${step.ID.X}, conditions on step.ID.X, reply_to). */
+export function renameWidget(root: any[], from: string, to: string) {
+    const ref = new RegExp(`\\$\\{step\\.${from}\\.`, "g")
+    const rewrite = (v: any): any => typeof v === "string" ? v.replace(ref, `\${step.${to}.`)
+        : Array.isArray(v) ? v.map(rewrite)
+            : v && typeof v === "object" ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, rewrite(x)])) : v
+    for (const w of flatten(root)) {
+        if (w.id === from) w.id = to
+        if (w.reply_to === from) w.reply_to = to
+        for (const c of w.conditions ?? []) {
+            if (typeof c.ref === "string" && c.ref.startsWith(`step.${from}.`)) c.ref = `step.${to}.` + c.ref.slice(from.length + 6)
+        }
+        for (const key of ["to", "cc", "subject", "body", "attachments", "question", "items", "value", "message", "sub_activity"]) {
+            if (typeof w[key] === "string") w[key] = rewrite(w[key])
+        }
+        if (w.params) w.params = rewrite(w.params)
+    }
+}
+
+/** One box of the diagram: a branch of the pipeline's top-level If / else chain on the activity, or the rest. */
+export interface Route {conditions: any[] | null, widgets: any[], ifId?: string}
+
+const onActivity = (w: any) => w?.widget === "IF" && (w.conditions ?? []).length > 0
+    && w.conditions.every((c: any) => String(c.ref ?? "").startsWith("activity."))
+
+/** If node type and sub-activity A, else if B, ..., else the rest: each branch and the rest as its own route. */
+export function routes(list: any[]): Route[] {
+    const out: Route[] = []
+    let rest = list ?? []
+    while (rest.length === 1 && onActivity(rest[0])) {
+        out.push({conditions: rest[0].conditions, widgets: rest[0].then ?? [], ifId: rest[0].id})
+        rest = rest[0].else ?? []
+    }
+    if (rest.length) out.push({conditions: null, widgets: rest})
+    return out
+}
+
+/** A new first branch for one node type (and sub-activity): the node pipeline's branch starts with the MOP execution. */
+export function addRoute(list: any[], hook: string, nodeType: string, subActivity: string): any[] {
+    const all = [...(list ?? [])]
+    const id = nextId(all, "IF")
+    const conditions = [{ref: "activity.node_type", op: "equals", value: nodeType},
+        ...(subActivity ? [{ref: "activity.sub_activity", op: "equals", value: subActivity}] : [])]
+    const then = hook === "node" ? [{...blank("NEI", nextId(all, "NEI")), label: "MOP execution"}] : []
+    return [{id, widget: "IF", label: [nodeType, subActivity].filter(Boolean).join(" "), conditions, then, else: all}]
+}
+
+/** The widget list at `path` in a hook's tree: [] = the hook's list, [2, "then"] = the then of its third widget. */
+export function listAt(root: any[], path: (string | number)[]): any[] | undefined {
+    let cur: any = root
+    for (const p of path) {
+        cur = cur?.[p]
+        if (cur === undefined) return undefined
+    }
+    return Array.isArray(cur) ? cur : undefined
+}
+
+/**
+ * A new widget of `type` in the step's `hook` pipeline, in the list at `path` before `index`. An empty per-node
+ * pipeline first gets the MOP execution it replaces, so adding a box never drops the node's MOP. Returns its id.
+ */
+export function insertWidget(step: any, hook: string, path: (string | number)[], index: number, type: string): string {
+    step.pipelines = step.pipelines ?? {}
+    if (!step.pipelines[hook]?.length) {
+        step.pipelines[hook] = hook === "node" ? [{...blank("NEI", "main"), label: "MOP execution"}] : []
+    }
+    const root = step.pipelines[hook]
+    const list = listAt(root, path) ?? root
+    const w = blank(type, nextId(root, type))
+    list.splice(Math.max(0, Math.min(index, list.length)), 0, w)
+    normalize(root)
+    return w.id
+}
+
+/** Removes a widget (and what it holds) from the hook's tree; true when found. */
+export function removeWidget(list: any[], id: string): boolean {
+    const i = (list ?? []).findIndex(w => w.id === id)
+    if (i >= 0) {
+        list.splice(i, 1)
+        return true
+    }
+    return (list ?? []).some(w => removeWidget(w.then, id) || removeWidget(w.else, id) || removeWidget(w.body, id))
+}
+
+/** A function the Flow view's arrows call to insert a widget where they are. */
+export const FLOW_INSERT: InjectionKey<(insert: {step: string, hook: string, path: (string | number)[], index: number}, type: string) => void> = Symbol("cr-flow-insert")
