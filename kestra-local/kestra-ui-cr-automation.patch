+
+    const props = defineProps<{data: FlowNode, selected?: boolean}>()
+
+    const ROUND = ["start", "end", "fail", "person"]
+    const ICON: Record<string, any> = {
+        step: Hexagon, nei: Hexagon, mail: EmailOutline, wait: PauseCircleOutline, person: AccountClockOutline, each: Sync,
+        collect: PlaylistPlus, report: FileChartOutline, start: PlayCircleOutline, end: CheckCircleOutline, fail: StopCircleOutline,
