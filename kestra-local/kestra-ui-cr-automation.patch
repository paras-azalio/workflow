+                                <KsInput v-model="a.name" :disabled="!editable" placeholder="CR_CIQ_PROCESSOR" class="pattern-input" />
+                                <KsInput v-model="a.description" :disabled="!editable" :placeholder="$t('description')" class="grow" />
