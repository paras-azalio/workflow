+            : op === "equals" ? (Array.isArray(operand) ? operand.join(",") : operand ?? "")
+                : Array.isArray(operand) ? operand : String(operand ?? "").split(",").filter(Boolean)
+        step.value.available_when = {...(step.value.available_when ?? {}), [path]: {[op]: value}}
+    }
+
+    function renameCondition(from: string, to: string) {
+        if (!to || from === to) return
+        const entries = Object.entries(step.value.available_when ?? {}).map(([p, v]) => [p === from ? to : p, v])
+        step.value.available_when = Object.fromEntries(entries)
+    }
+
+    function removeCondition(path: string) {
+        const next = {...(step.value.available_when ?? {})}
+        delete next[path]
+        step.value.available_when = Object.keys(next).length ? next : undefined
+    }
+
+    function addCondition() {
+        const path = paths.value.find(p => !(p in (step.value.available_when ?? {}))) ?? "order.stage"
+        setCondition(path, "non_empty", true)
+    }
+</script>
+
