+<template>
+    <div class="version-bar">
+        <KsSelect
+            :modelValue="selected"
+            class="version-select"
+            :placeholder="$t('cr_designer.version')"
+            @update:model-value="(v: number) => emit('select', v)"
+        >
+            <KsOption
+                v-for="v in versions"
+                :key="v.version"
+                :label="`v${v.version} · ${v.state}`"
+                :value="v.version"
+            />
+        </KsSelect>
+        <KsTag v-if="current" :type="stateType(current.state)">
+            {{ current.state }}
+        </KsTag>
+        <span v-if="dirty" class="version-dirty">{{ $t("cr_designer.unsaved") }}</span>
+        <div class="version-actions">
+            <template v-if="admin">
+                <KsButton v-if="!hasDraft" :icon="Plus" :disabled="busy" @click="emit('draft')">
+                    {{ $t("cr_designer.new_draft", {from: selected ?? "-"}) }}
+                </KsButton>
+                <template v-if="current?.state === 'DRAFT'">
+                    <KsButton type="primary" :icon="ContentSave" :disabled="busy || !dirty" @click="emit('save')">
+                        {{ $t("save") }}
+                    </KsButton>
+                    <KsButton :icon="RocketLaunchOutline" :disabled="busy || dirty" @click="emit('publish')">
+                        {{ $t("cr_designer.publish") }}
+                    </KsButton>
+                    <KsButton :icon="Delete" :disabled="busy" @click="emit('discard')">
+                        {{ $t("cr_designer.discard") }}
+                    </KsButton>
+                </template>
+                <KsButton v-if="current?.state === 'PUBLISHED'" :icon="ArchiveOutline" :disabled="busy" @click="emit('retire')">
+                    {{ $t("cr_designer.retire") }}
+                </KsButton>
+            </template>
+            <span v-else class="version-hint">{{ $t("cr_designer.read_only") }}</span>
+        </div>
+    </div>
+    <KsAlert v-if="error" type="error" :closable="false" class="version-message">
+        {{ error }}
+    </KsAlert>
+    <KsAlert v-if="problems.length" type="warning" :closable="false" class="version-message">
+        <strong>{{ $t("cr_designer.problems", {count: problems.length}) }}</strong>
+        <ul class="version-problems">
+            <li v-for="(p, i) in problems" :key="i">
+                {{ p }}
+            </li>
+        </ul>
+    </KsAlert>
+    <KsAlert v-if="message" type="success" :closable="false" class="version-message">
+        {{ message }}
+    </KsAlert>
+</template>
+
+<script setup lang="ts">
+    import {computed} from "vue"
+    import Plus from "vue-material-design-icons/Plus.vue"
+    import ContentSave from "vue-material-design-icons/ContentSave.vue"
+    import RocketLaunchOutline from "vue-material-design-icons/RocketLaunchOutline.vue"
+    import Delete from "vue-material-design-icons/Delete.vue"
+    import ArchiveOutline from "vue-material-design-icons/ArchiveOutline.vue"
+    import type {VersionSummary} from "./crApi"
+
+    const props = defineProps<{
+        versions: VersionSummary[],
+        selected?: number,
+        admin: boolean,
+        dirty: boolean,
+        busy: boolean,
+        error?: string,
+        message?: string,
+        problems: string[],
+    }>()
+    const emit = defineEmits<{
+        select: [version: number],
+        draft: [],
+        save: [],
+        publish: [],
+        discard: [],
+        retire: [],
+    }>()
+
+    const current = computed(() => props.versions.find(v => v.version === props.selected))
+    const hasDraft = computed(() => props.versions.some(v => v.state === "DRAFT"))
+    const stateType = (state: string) => state === "PUBLISHED" ? "success" : state === "DRAFT" ? "warning" : "info"
+</script>
+
+<style scoped lang="scss">
+    .version-bar {
+        display: flex;
+        flex-wrap: wrap;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .version-select {
+        width: 12rem;
+    }
+
+    .version-actions {
+        display: flex;
+        gap: var(--ks-spacing-2);
+        margin-left: auto;
+    }
+
+    .version-dirty, .version-hint {
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .version-message {
+        margin-top: var(--ks-spacing-2);
+    }
+
+    .version-problems {
+        margin: var(--ks-spacing-1) 0 0;
+        padding-left: var(--ks-spacing-5);
+    }
+</style>
