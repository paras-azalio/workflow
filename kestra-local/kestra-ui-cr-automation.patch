+                                <KsOption value="FOLDER" :label="$t('cr_designer.comp_location_FOLDER')" />
+                            </KsSelect>
+                            <KsInput v-if="spec.location === 'FOLDER'" v-model="spec.folder" :disabled="!editable" placeholder="nei/clicr" class="pattern-input" />
+                        </div>
+                        <p class="hint">{{ spec.location === "FOLDER" ? $t("cr_designer.comp_folder_hint") : $t("cr_designer.comp_upload_hint", {dir}) }}</p>
