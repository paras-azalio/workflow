+
+    const paths = computed(() => [
+        ...props.fields.order.map(f => `order.${f}`),
+        ...(step.value.scope === "CHILD" ? props.fields.child.map(f => `child.${f}`) : []),
+    ])
+
+    const flow = computed(() => props.flows.find(f => f.id === step.value.runs?.flow))
+    // ProcessDesigner gives every step an inputs object when it loads or creates it
+    const inputs = computed<Record<string, any>>(() => step.value.inputs)
+    /** Every input the flow declares, plus any the step maps that the flow no longer declares. */
+    const inputNames = computed(() => [...new Set([...(flow.value?.inputs ?? []).map(i => i.id), ...Object.keys(inputs.value)])])
+    const widgetCount = (hook: string) => flattenWidgets(step.value.pipelines?.[hook] ?? []).length
+    const flowInputType = (name: string) => flow.value?.inputs.find(i => i.id === name)?.type ?? "?"
+
+    const extra = reactive({hook: "", nodeType: "", subActivity: ""})
+
+    /** A new box: a first If branch for the node type (and sub-activity); everything else moves to its else. */
+    function addExtra() {
+        step.value.pipelines = {...step.value.pipelines}
+        const routed = addRoute(step.value.pipelines[extra.hook] ?? [], extra.hook, extra.nodeType.trim(), extra.subActivity.trim())
+        step.value.pipelines[extra.hook] = normalizeWidgets(routed)
+        emit("edit-pipeline", extra.hook)
+        extra.nodeType = ""
+        extra.subActivity = ""
+    }
+
+    const selectInputs = computed(() => Object.entries(inputs.value)
+        .filter(([, spec]: [string, any]) => spec?.from === "user" && spec.type === "SELECT")
+        .map(([name]) => name))
+
+    function toggleAutoStart(on: string | number | boolean) {
+        if (on) step.value.auto_start = selectInputs.value.length ? {for_each: selectInputs.value[0]} : {}
+        else delete step.value.auto_start
+    }
+
+    // KsInputNumber emits its value once when it mounts, and the gateway sends numbers back as text: an unchanged
+    // value written back would mark the version edited
+    function setAutoStart(key: string, value: string | number | undefined) {
+        if (String(step.value.auto_start?.[key] ?? "") === String(value ?? "")) return
+        const next = {...step.value.auto_start}
+        if (value === undefined) delete next[key]
+        else next[key] = value
+        step.value.auto_start = next
+    }
+
+    function sourceOf(name: string): string {
+        const spec = inputs.value[name]
+        if (!spec) return ""
+        if ("value" in spec) return "value"
+        if (spec.from === "user") return "user"
+        return String(spec.from ?? "").startsWith("child.") ? "child" : "order"
+    }
+
+    function setSource(name: string, source: string) {
+        const userType: Record<string, string> = {BOOL: "BOOL", SELECT: "SELECT", MULTISELECT: "MULTISELECT", FILE: "FILE"}
+        if (source === "") delete inputs.value[name]
+        else if (source === "value") inputs.value[name] = {value: ""}
+        else if (source === "order") inputs.value[name] = {from: "order.value"}
+        else if (source === "child") inputs.value[name] = {from: "child.child_id"}
+        else inputs.value[name] = {from: "user", type: userType[flowInputType(name)] ?? "STRING", label: name, required: false}
+    }
+
+    const defaultText = (spec: any) => Array.isArray(spec.default) ? spec.default.join(",") : String(spec.default ?? "")
+
+    function setDefault(spec: any, text: string) {
+        if (text === "") delete spec.default
+        else if (spec.type === "MULTISELECT") spec.default = text.split(",").map(s => s.trim()).filter(Boolean)
+        else if (spec.type === "BOOL") spec.default = text === "true"
+        else spec.default = text
+    }
+
+    const conditionRows = computed(() => Object.entries(step.value.available_when ?? {}).map(([path, op]: [string, any]) => {
+        const [operator, operand] = Object.entries(op ?? {})[0] ?? ["non_empty", true]
+        return {path, op: operator, operand}
+    }))
+
+    function setCondition(path: string, op: string, operand: any) {
+        const value = op === "non_empty" || op === "empty" ? true
+            : op === "equals" ? (Array.isArray(operand) ? operand.join(",") : operand ?? "")
+                : Array.isArray(operand) ? operand : String(operand ?? "").split(",").filter(Boolean)
+        step.value.available_when = {...(step.value.available_when ?? {}), [path]: {[op]: value}}
+    }
+
+    function renameCondition(from: string, to: string) {
+        if (!to || from === to) return
+        const entries = Object.entries(step.value.available_when ?? {}).map(([p, v]) => [p === from ? to : p, v])
+        step.value.available_when = Object.fromEntries(entries)
+    }
+
+    function removeCondition(path: string) {
+        const next = {...(step.value.available_when ?? {})}
+        delete next[path]
+        step.value.available_when = Object.keys(next).length ? next : undefined
+    }
+
+    function addCondition() {
+        const path = paths.value.find(p => !(p in (step.value.available_when ?? {}))) ?? "order.stage"
+        setCondition(path, "non_empty", true)
+    }
+</script>
+
+<style scoped lang="scss">
+    .step-editor {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+    }
+
+    .editor-head, .input-head, .field-row, .condition-row {
+        display: flex;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .editor-head {
+        justify-content: space-between;
+    }
+
+    h4, h5 {
+        margin: var(--ks-spacing-2) 0 0;
+    }
+
+    .field {
+        display: flex;
+        flex: 1;
+        flex-direction: column;
+        gap: var(--ks-spacing-1);
+        font-size: var(--ks-font-size-sm);
+        color: var(--ks-text-secondary);
+    }
+
+    .hint {
+        margin: 0;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    .input-row {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-1);
+        padding: var(--ks-spacing-2);
+        border: 1px solid var(--ks-border-subtle);
+        border-radius: var(--ks-spacing-1);
+    }
+
+    .source-select {
+        margin-left: auto;
+        width: 10rem;
+    }
+</style>
