+<template>
+    <div class="order">
+        <div v-if="!orderId" class="order-empty">
+            {{ $t("cr_order.not_an_order") }}
+        </div>
+        <div v-else-if="loadError" class="order-empty">
+            {{ loadError }}
+        </div>
+        <div v-else-if="!order" class="order-empty">
+            {{ $t("loading") }}
+        </div>
+        <template v-else>
+            <section class="order-card">
+                <h3>{{ $t("cr_order.order") }} {{ orderId }} <span class="order-stage" :class="order.stage">{{ order.stage }}</span></h3>
+                <dl>
+                    <dt>{{ $t("cr_order.activity") }}</dt>
+                    <dd>{{ order.node_type }}_{{ order.activity }} ({{ order.node_version }})</dd>
+                    <dt>{{ $t("cr_order.folder") }}</dt>
+                    <dd>{{ order.order_dir }}</dd>
+                    <dt>CRs</dt>
+                    <dd>{{ (order.cr_list ?? []).join(", ") || "-" }}</dd>
+                </dl>
+                <table class="order-table">
+                    <thead>
+                        <tr><th>{{ $t("cr_order.step") }}</th><th>{{ $t("cr_order.result") }}</th><th>{{ $t("cr_order.at") }}</th></tr>
+                    </thead>
+                    <tbody>
+                        <tr v-for="(step, i) in order.steps ?? []" :key="i">
+                            <td><a href="#" @click.prevent="open(step.execution_id)">{{ step.execution_id }}</a></td>
+                            <td>{{ step.stage }}</td>
+                            <td>{{ step.at }}</td>
+                        </tr>
+                        <template v-for="(runs, cr) in order.children ?? {}" :key="cr">
+                            <tr v-for="run in runs" :key="run.child_id">
+                                <td>
+                                    {{ $t("cr_order.child") }} {{ run.child_id }} ({{ cr }})
+                                    <a v-if="run.execution_id" href="#" @click.prevent="open(run.execution_id, CHILD_FLOW)">{{ $t("cr_order.open") }}</a>
+                                </td>
+                                <td>
+                                    {{ run.state }}
+                                    <div v-for="n in run.nodes ?? []" :key="n.node" class="order-node">
+                                        {{ n.node }}: {{ n.status }}{{ n.rolled_back ? ", " + $t("cr_order.rolled_back") : "" }}
+                                    </div>
+                                </td>
+                                <td>{{ run.at }}</td>
+                            </tr>
+                        </template>
+                    </tbody>
+                </table>
+            </section>
+
+            <section v-if="!continuable" class="order-card">
+                <h3>{{ $t("cr_order.continue") }}</h3>
+                <p class="order-hint">{{ $t("cr_order.not_continuable", {order: orderId}) }}</p>
+            </section>
+
+            <section v-else-if="childId" class="order-card">
+                <h3>{{ $t("cr_order.child_continue", {child: childId, cr: child?.cr_name ?? ""}) }}</h3>
+
+                <div v-if="childNodes.length" class="order-action">
+                    <h4>{{ $t("cr_order.exec_title") }}</h4>
+                    <p class="order-hint">{{ $t("cr_order.exec_hint") }}</p>
+                    <label class="order-check">
+                        <input v-model="allNodes" type="checkbox">
+                        {{ $t("cr_order.exec_all", {count: childNodes.length}) }}
+                    </label>
+                    <label v-for="o in childNodes" :key="o.value" class="order-check order-node-choice">
+                        <input v-model="chosenNodes" type="checkbox" :value="o.value" :disabled="allNodes || isRunning(o.value)">
+                        {{ o.label }}
+                    </label>
+                    <button type="button" class="order-run" :disabled="!nodesToRun.length || busy" @click="runExecutionStep">
+                        {{ $t("cr_order.exec_run") }}
+                    </button>
+                </div>
+                <p v-else class="order-hint">{{ $t("cr_order.exec_no_mop") }}</p>
+
+                <div v-if="childRollbackOptions.length" class="order-action">
+                    <h4>{{ $t("cr_order.rollback_title") }}</h4>
+                    <p class="order-hint">{{ $t("cr_order.rollback_hint") }}</p>
+                    <select v-model="rollbackTarget" class="order-select">
+                        <option v-for="o in childRollbackOptions" :key="o.value" :value="o.value">
+                            {{ o.label }}
+                        </option>
+                    </select>
+                    <button type="button" class="order-run" :disabled="!rollbackTarget || busy" @click="runRollback">
+                        {{ $t("cr_order.rollback_run") }}
+                    </button>
+                </div>
+
+                <p v-if="actionError" class="order-error">{{ actionError }}</p>
+            </section>
+
+            <section v-else class="order-card">
+                <h3>{{ $t("cr_order.continue") }}</h3>
+
+                <div class="order-action">
+                    <h4>{{ $t("cr_order.validate_title") }}</h4>
+                    <p class="order-hint">{{ $t("cr_order.validate_hint") }}</p>
+                    <input type="file" accept=".xlsx" @change="ciqFile = ($event.target as HTMLInputElement).files?.[0]">
+                    <button type="button" class="order-run" :disabled="busy" @click="runValidation">
+                        {{ $t("cr_order.validate_run") }}
+                    </button>
+                </div>
+
+                <div v-if="order.stage === 'VALIDATED'" class="order-action">
+                    <h4>{{ $t("cr_order.child_title") }}</h4>
+                    <select v-model="crName" class="order-select">
+                        <option v-for="o in order.cr_options ?? []" :key="o.value" :value="o.value">
+                            {{ o.label }}
+                        </option>
+                    </select>
+                    <label class="order-check">
+                        <input v-model="runExecution" type="checkbox">
+                        {{ $t("cr_order.run_execution") }}
+                    </label>
+                    <button type="button" class="order-run" :disabled="!crName || busy" @click="runChild">
+                        {{ $t("cr_order.child_run") }}
+                    </button>
+                </div>
+                <p v-else class="order-hint">{{ $t("cr_order.child_after_validation") }}</p>
+
+                <div v-if="(order.rollback_options ?? []).length" class="order-action">
+                    <h4>{{ $t("cr_order.rollback_title") }}</h4>
+                    <p class="order-hint">{{ $t("cr_order.rollback_hint") }}</p>
+                    <select v-model="rollbackTarget" class="order-select">
+                        <option v-for="o in order.rollback_options" :key="o.value" :value="o.value">
+                            {{ o.label }}
+                        </option>
+                    </select>
+                    <button type="button" class="order-run" :disabled="!rollbackTarget || busy" @click="runRollback">
+                        {{ $t("cr_order.rollback_run") }}
+                    </button>
+                </div>
+
+                <p v-if="actionError" class="order-error">{{ actionError }}</p>
+            </section>
+        </template>
+    </div>
+</template>
+
+<script setup lang="ts">
+    /**
+     * "Order" tab (cr_automation): the order this execution belongs to (label order_id), as the flows publish it
+     * from the request store (namespace KV ORDER_<id>, written by bin/store.sh registry), and the next steps,
+     * like FlowOne's order actions. On an order: validate a (corrected) CIQ, start a child order for one of its CRs,
+     * roll back a node. On a child order: only execute its MOP on some or all of its nodes, or roll back one of its
+     * nodes. Each starts a normal execution of ciq_validation / cr_child_order / cr_mop_execution / cr_node_rollback.
+     */
+    import {computed, ref, watch} from "vue"
+    import {useRouter, useRoute} from "vue-router"
+    import {useClient} from "@kestra-io/kestra-sdk"
+    import {apiUrl} from "override/utils/route"
+    import {useExecutionsStore} from "../../stores/executions"
+
+    const VALIDATION_FLOW = "ciq_validation"
+    const CHILD_FLOW = "cr_child_order"
+    const EXECUTION_FLOW = "cr_mop_execution"
+    const ROLLBACK_FLOW = "cr_node_rollback"
+    const ALL_NODES = "*"
+
+    const executionsStore = useExecutionsStore()
+    const router = useRouter()
+    const route = useRoute()
+    const http = useClient()
+    const execution = computed(() => executionsStore.execution)
+
+    const label = (key: string) => execution.value?.labels?.find((l: any) => l.key === key)?.value
+    const orderId = computed(() => label("order_id"))
+    // an execution of a child order carries the child's request id, which differs from its order's
+    const childId = computed(() => {
+        const reqId = label("req_id")
+        return reqId && reqId !== orderId.value ? reqId : undefined
+    })
+    const order = ref<any>()
+    // the orders the flows' forms accept (KV ORDERS, published from the request store); an order missing there
+    // (e.g. one created before the store) is shown, but offering its next steps would only end in a rejected form
+    const continuable = ref(false)
+    const loadError = ref("")
+    const ciqFile = ref<File | undefined>()
+    const crName = ref("")
+    const runExecution = ref(false)
+    const rollbackTarget = ref("")
+    const busy = ref(false)
+    const actionError = ref("")
+
+    const child = computed(() => childId.value ? order.value?.children_by_id?.[childId.value] : undefined)
+    const childNodes = computed(() => (child.value?.node_options ?? []).filter((o: any) => o.value !== ALL_NODES))
+    const childRollbackOptions = computed(() =>
+        (order.value?.rollback_options ?? []).filter((o: any) => String(o.value).startsWith(childId.value + ":")))
+    const allNodes = ref(true)
+    const chosenNodes = ref<string[]>([])
+    const isRunning = (node: string) => child.value?.nodes?.some((n: any) => n.node === node && n.status === "RUNNING")
+    const nodesToRun = computed(() => allNodes.value ? [ALL_NODES] : chosenNodes.value)
+
+    async function load() {
+        if (!orderId.value || !execution.value) return
+        try {
+            const kv = `${apiUrl()}/namespaces/${execution.value.namespace}/kv`
+            const [response, orders] = await Promise.all([http.get(`${kv}/ORDER_${orderId.value}`), http.get(`${kv}/ORDERS`)])
+            order.value = response.data?.value ?? response.data
+            const list = orders.data?.value ?? orders.data
+            continuable.value = Array.isArray(list) && list.some((o: any) => String(o.value) === String(orderId.value))
+            loadError.value = ""
+            if (!crName.value && order.value?.cr_list?.length) crName.value = order.value.cr_list[0]
+        } catch (e) {
+            loadError.value = "Order " + orderId.value + " is not in the order registry (" + e + ")"
+        }
+    }
+
+    function open(executionId: string, flowId?: string) {
+        router.push({
+            name: "executions/update",
+            params: {tenant: route.params.tenant, namespace: execution.value?.namespace, flowId: flowId ?? flowOf(executionId), id: executionId},
+        })
+    }
+
+    // the order's own steps: GENERATE_TEMPLATE (generate_ciq_template) or CIQ_VALIDATION (ciq_validation)
+    function flowOf(executionId: string) {
+        const step = order.value?.steps?.find((s: any) => s.execution_id === executionId)
+        return String(step?.stage ?? "").startsWith("GENERATE_TEMPLATE") ? "generate_ciq_template" : VALIDATION_FLOW
+    }
+
+    async function start(flowId: string, formData: Record<string, any>) {
+        busy.value = true
+        actionError.value = ""
+        try {
+            const created: any = await executionsStore.triggerExecution({
+                namespace: execution.value!.namespace!, id: flowId, formData, kind: "NORMAL",
+            })
+            open(created.id, flowId)
+        } catch (e: any) {
+            actionError.value = e?.response?.data?.message ?? String(e)
+        } finally {
+            busy.value = false
+        }
+    }
+
+    // no file chosen: the flow validates the CIQ already placed in the order folder
+    const runValidation = () => start(VALIDATION_FLOW, {
+        order_type: "EXISTING", order_id: orderId.value, ...(ciqFile.value ? {ciq: ciqFile.value} : {}),
+    })
+    const runChild = () => start(CHILD_FLOW, {order_id: orderId.value, cr_name: crName.value, run_execution: runExecution.value})
+    const runRollback = () => start(ROLLBACK_FLOW, {order_id: orderId.value, node: rollbackTarget.value})
+    // MULTISELECT inputs go to the API as a JSON array, as Kestra's own execute form sends them
+    const runExecutionStep = () => start(EXECUTION_FLOW, {
+        order_id: orderId.value, child_id: childId.value, nodes: JSON.stringify(nodesToRun.value),
+    })
+
+    watch(() => [execution.value?.id, execution.value?.state?.current, orderId.value], load, {immediate: true})
+</script>
