+<template>
+    <div class="io-mml">
+        <div v-if="loading" class="io-mml-empty">
+            {{ $t("loading") }}
+        </div>
+        <div v-else-if="groups.length === 0" class="io-mml-empty">
+            {{ $t("io_mml_logs.empty") }}
+        </div>
+        <template v-else>
+            <aside class="io-mml-list">
+                <div v-for="group in groups" :key="group.name" class="io-mml-group">
+                    <div class="io-mml-group-name" :title="group.name">
+                        {{ group.name }}
+                    </div>
+                    <div class="io-mml-kinds">
+                        <button
+                            v-for="kind in KINDS.filter(k => group.files[k])"
+                            :key="kind"
+                            type="button"
+                            class="io-mml-kind"
+                            :class="{active: selected?.group === group.name && selected?.kind === kind}"
+                            @click="select(group, kind)"
+                        >
+                            {{ kind }}
+                        </button>
+                    </div>
+                </div>
+            </aside>
+            <section class="io-mml-view">
+                <div class="io-mml-bar">
+                    <span class="io-mml-file">{{ selectedFile?.name }}</span>
+                    <input
+                        v-model="filter"
+                        class="io-mml-filter"
+                        type="search"
+                        :placeholder="$t('io_mml_logs.filter')"
+                    >
+                    <a v-if="selectedFile" class="io-mml-download" :href="downloadUrl(selectedFile.uri)">
+                        {{ $t("download") }}
+                    </a>
+                </div>
+                <div v-if="contentLoading" class="io-mml-empty">
+                    {{ $t("loading") }}
+                </div>
+                <pre v-else class="io-mml-content"><code>{{ shownContent }}</code></pre>
+            </section>
+        </template>
+    </div>
+</template>
+
+<script setup lang="ts">
+    /**
+     * "IO / MML" tab (cr_automation): the NEI logs of the execution's order, like FlowOne's IO and MML views.
+     *   IO   <log-name>.io.log    request parameters in, status and results out (NEI component wrapper)
+     *   MML  <log-name>.mml       what the NEI wrote with printMml, closed with $END$ <request id>
+     *   EXEC <node>_execution.log CLICR's execution log of a node
+     * The files are output files of the execution: the flows' collect_logs step copies the order folder's
+     * logs (all steps, also those of Loop iterations); without it, every task's own output files are used.
+     */
+    import {computed, ref, watch} from "vue"
+    import * as OutputsAPI from "@kestra-io/kestra-sdk/outputs"
+    import {apiUrl} from "override/utils/route"
+    import {useExecutionsStore} from "../../stores/executions"
+
+    type Kind = "IO" | "MML" | "EXEC"
+    interface LogFile { name: string; uri: string }
+    interface Group { name: string; files: Partial<Record<Kind, LogFile>> }
+
+    const KINDS: Kind[] = ["IO", "MML", "EXEC"]
+    const COLLECT_TASK = "collect_logs"
+
+    const executionsStore = useExecutionsStore()
+    const execution = computed(() => executionsStore.execution)
+
+    const loading = ref(true)
+    const groups = ref<Group[]>([])
+    const selected = ref<{group: string; kind: Kind} | undefined>()
+    const content = ref("")
+    const contentLoading = ref(false)
+    const filter = ref("")
+
+    function classify(path: string): {group: string; kind: Kind; name: string} | undefined {
+        const name = path.split("/").pop() ?? path
+        if (name.endsWith(".io.log")) return {group: name.slice(0, -".io.log".length), kind: "IO", name}
+        if (name.endsWith(".mml")) return {group: name.slice(0, -".mml".length), kind: "MML", name}
+        if (name.endsWith("_execution.log")) {
+            // CLICR's <node>_execution.log belongs to the wrapper logs mop_execution_<node>, or mop_rollback_<node>
+            // for a rollback run (cr_node_rollback keeps its engine logs in LOGS_ROLLBACK/)
+            const step = path.includes("LOGS_ROLLBACK/") ? "mop_rollback_" : "mop_execution_"
+            return {group: step + name.slice(0, -"_execution.log".length), kind: "EXEC", name}
+        }
+        return undefined
+    }
+
+    async function loadGroups(executionId: string) {
+        const runs = await OutputsAPI.taskOutputsInformation({executionId}, {
+            validateStatus: (s: number) => s === 200 || s === 404,
+        }) ?? []
+        const collect = runs.filter((r) => r.taskId === COLLECT_TASK)
+        const byName = new Map<string, Group>()
+        for (const run of (collect.length > 0 ? collect : runs)) {
+            if (!run.taskRunId) continue
+            const outputs: any = await OutputsAPI.taskRunOutputs({executionId, taskRunId: run.taskRunId}, {
+                validateStatus: (s: number) => s === 200 || s === 404,
+            }) ?? {}
+            for (const [path, uri] of Object.entries(outputs.outputFiles ?? {})) {
+                const c = classify(path)
+                if (!c) continue
+                const group = byName.get(c.group) ?? {name: c.group, files: {}}
+                group.files[c.kind] = {name: c.name, uri: String(uri)}
+                byName.set(c.group, group)
+            }
+        }
+        return [...byName.values()]
+    }
+
+    async function select(group: Group, kind: Kind) {
+        const file = group.files[kind]
+        const id = execution.value?.id
+        if (!file || !id) return
+        selected.value = {group: group.name, kind}
+        contentLoading.value = true
+        try {
+            content.value = await executionsStore.fileContent({executionId: id, path: file.uri})
+        } catch (e) {
+            content.value = "Could not load " + file.name + ": " + e
+        } finally {
+            contentLoading.value = false
+        }
+    }
+
+    const selectedFile = computed(() => {
+        const s = selected.value
+        return s ? groups.value.find((g) => g.name === s.group)?.files[s.kind] : undefined
+    })
+
+    const shownContent = computed(() => {
+        const f = filter.value.trim().toLowerCase()
+        return f ? content.value.split("\n").filter((l) => l.toLowerCase().includes(f)).join("\n") : content.value
+    })
+
+    function downloadUrl(uri: string) {
+        return `${apiUrl()}/executions/${execution.value?.id}/file?path=${encodeURIComponent(uri)}`
+    }
+
+    // Reload while the execution runs: collect_logs (a finally task) adds the files at the end.
+    watch(
+        () => [execution.value?.id, execution.value?.state?.current] as const,
+        async ([id]) => {
+            if (!id) return
+            try {
+                groups.value = await loadGroups(id)
+            } finally {
+                loading.value = false
+            }
+            const keep = selected.value && groups.value.find((g) => g.name === selected.value?.group)
+            if (keep && selected.value) {
+                await select(keep, selected.value.kind)
+            } else if (groups.value.length > 0) {
+                const first = groups.value[0]
+                await select(first, KINDS.find((k) => first.files[k]) ?? "IO")
+            }
+        },
+        {immediate: true},
+    )
+</script>
+
+<style scoped lang="scss">
+    .io-mml {
+        display: flex;
+        gap: 1rem;
+        min-height: 60vh;
+    }
+
+    .io-mml-empty {
+        padding: 1rem;
+        color: var(--ks-text-secondary);
+    }
+
+    .io-mml-list {
+        flex: 0 0 18rem;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.5rem;
+        background: var(--ks-bg-surface);
+        overflow: auto;
+    }
+
+    .io-mml-group {
+        padding: 0.5rem 0.75rem;
+        border-bottom: 1px solid var(--ks-border-default);
+    }
+
+    .io-mml-group-name {
+        color: var(--ks-text-primary);
+        font-size: var(--ks-font-size-sm);
+        overflow: hidden;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    .io-mml-kinds {
+        display: flex;
+        gap: 0.375rem;
+        margin-top: 0.375rem;
+    }
+
+    .io-mml-kind {
+        padding: 0.125rem 0.625rem;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.25rem;
+        background: transparent;
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+        cursor: pointer;
+
+        &.active, &:hover {
+            background: var(--ks-dropdown-bg-active);
+            color: var(--ks-text-primary);
+        }
+    }
+
+    .io-mml-view {
+        flex: 1;
+        min-width: 0;
+        display: flex;
+        flex-direction: column;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.5rem;
+        background: var(--ks-bg-surface);
+    }
+
+    .io-mml-bar {
+        display: flex;
+        align-items: center;
+        gap: 0.75rem;
+        padding: 0.5rem 0.75rem;
+        border-bottom: 1px solid var(--ks-border-default);
+    }
+
+    .io-mml-file {
+        flex: 1;
+        color: var(--ks-text-primary);
+        font-size: var(--ks-font-size-sm);
+        overflow: hidden;
+        text-overflow: ellipsis;
+        white-space: nowrap;
+    }
+
+    .io-mml-filter {
+        width: 14rem;
+        padding: 0.25rem 0.5rem;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.25rem;
+        background: var(--ks-bg-base);
+        color: var(--ks-text-primary);
+    }
+
+    .io-mml-download {
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .io-mml-content {
+        flex: 1;
+        margin: 0;
+        padding: 0.75rem;
+        overflow: auto;
+        max-height: 70vh;
+        color: var(--ks-text-primary);
+        font-size: var(--ks-font-size-xs);
+        white-space: pre;
+    }
+</style>
