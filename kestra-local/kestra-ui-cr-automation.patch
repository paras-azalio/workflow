@@ -0,0 +1,70 @@
+<template>
+    <div class="json-view">
+        <textarea v-model="text" class="json-text" :readonly="!editable" spellcheck="false" data-test="json-view" />
+        <div v-if="editable" class="json-actions">
+            <KsButton :icon="CodeJson" :disabled="text === original" @click="apply">
+                {{ $t("cr_designer.apply_json") }}
+            </KsButton>
+            <span v-if="invalid" class="json-error">{{ invalid }}</span>
+        </div>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {ref, watch} from "vue"
+    import {useI18n} from "vue-i18n"
+    import CodeJson from "vue-material-design-icons/CodeJson.vue"
+
+    const props = defineProps<{value: any, editable: boolean}>()
+    const emit = defineEmits<{apply: [value: any]}>()
+    const {t} = useI18n()
+
+    const original = ref("")
+    const text = ref("")
+    const invalid = ref("")
+
+    watch(() => props.value, v => {
+        original.value = JSON.stringify(v, null, 2)
+        text.value = original.value
+        invalid.value = ""
+    }, {immediate: true, deep: true})
+
+    function apply() {
+        try {
+            emit("apply", JSON.parse(text.value))
+            invalid.value = ""
+        } catch (e: any) {
+            invalid.value = t("cr_designer.json_invalid", {error: e?.message ?? String(e)})
+        }
+    }
+</script>
+
+<style scoped lang="scss">
+    .json-view {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-2);
+    }
+
+    .json-text {
+        width: 100%;
+        height: 65vh;
+        padding: var(--ks-spacing-3);
+        border: 1px solid var(--ks-border-default);
+        border-radius: var(--ks-spacing-2);
+        background: var(--ks-bg-input);
+        color: var(--ks-text-primary);
+        font-family: monospace;
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .json-actions {
+        display: flex;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .json-error {
+        color: var(--ks-text-error);
+    }
+</style>
diff --git a/ui/src/components/crdesigner/KeyValues.vue b/ui/src/components/crdesigner/KeyValues.vue
new file mode 100644
index 0000000..0f1c16e
--- /dev/null
+++ b/ui/src/components/crdesigner/KeyValues.vue
@@ -0,0 +1,85 @@
+<template>
+    <div class="key-values" :data-test="`key-values-${group}`">
+        <div class="kv-head">
+            <strong>{{ $t(`cr_designer.group_${group}`) }}</strong>
+            <span class="hint">{{ $t(`cr_designer.group_${group}_hint`) }}</span>
+        </div>
+        <div v-for="[key, value] in entries" :key="key" class="kv-row">
+            <KsInput :modelValue="key" class="kv-key" :disabled="!editable" @change="(k: string | number) => rename(key, String(k))" />
+            <KsInput :modelValue="value" class="kv-value" :disabled="!editable" @change="(v: string | number) => set(key, String(v))" />
+            <KsButton v-if="editable" :icon="Close" size="small" :aria-label="$t('delete')" @click="remove(key)" />
+            <span v-if="needsSecret(key, value)" class="kv-warning">{{ $t("cr_designer.secret_hint") }}</span>
+        </div>
+        <KsButton v-if="editable" :icon="Plus" size="small" @click="add">
+            {{ $t("cr_designer.add_key") }}
+        </KsButton>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed} from "vue"
+    import Close from "vue-material-design-icons/Close.vue"
+    import Plus from "vue-material-design-icons/Plus.vue"
+
+    const SECRET_KEY = /password|passwd|pswd|pwd|secret|token/i
+    const SECRET_REF = /^\$\{secret:[A-Za-z0-9_]+\}$/
+
+    const model = defineModel<Record<string, string> | undefined>()
+    defineProps<{group: "params" | "login" | "grc", editable: boolean}>()
+
+    const entries = computed(() => Object.entries(model.value ?? {}))
+    const needsSecret = (key: string, value: string) => SECRET_KEY.test(key) && !!value && !SECRET_REF.test(String(value))
+
+    function rename(from: string, to: string) {
+        if (!to || to === from || to in (model.value ?? {})) return
+        model.value = Object.fromEntries(entries.value.map(([k, v]) => [k === from ? to : k, v]))
+    }
+
+    const set = (key: string, value: string) => model.value = {...model.value, [key]: value}
+
+    function remove(key: string) {
+        const next = {...model.value}
+        delete next[key]
+        model.value = Object.keys(next).length ? next : undefined
+    }
+
+    function add() {
+        let n = entries.value.length + 1
+        while (`KEY_${n}` in (model.value ?? {})) n++
+        set(`KEY_${n}`, "")
+    }
+</script>
+
+<style scoped lang="scss">
+    .key-values {
+        display: flex;
+        flex-direction: column;
+        gap: var(--ks-spacing-1);
+    }
+
+    .kv-head, .kv-row {
+        display: flex;
+        flex-wrap: wrap;
+        gap: var(--ks-spacing-2);
+        align-items: center;
+    }
+
+    .kv-key {
+        width: 20rem;
+    }
+
+    .kv-value {
+        flex: 1;
+    }
+
+    .hint {
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    .kv-warning {
+        width: 100%;
+        color: var(--ks-text-warning);
+        font-size: var(--ks-font-size-xs);
+    }
+</style>
