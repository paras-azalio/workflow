new file mode 100644
index 0000000..c3aeddf
--- /dev/null
+++ b/ui/src/components/crdesigner/useVersioned.ts
@@ -0,0 +1,103 @@
+import {computed, ref} from "vue"
+import {onBeforeRouteLeave} from "vue-router"
+import {useI18n} from "vue-i18n"
+import {useToast} from "../../utils/toast"
+import {gateway, clone} from "./crApi"
+import type {VersionSummary} from "./crApi"
+
+/**
+ * The versions of one process or activity as the gateway keeps them (DRAFT / PUBLISHED / RETIRED), the loaded
+ * version's content as an editable copy, and the VersionBar actions. The gateway checks the role and the revision.
+ */
+export function useVersioned(options: {
+    base: () => string,
+    field: "definition" | "config",
+    normalize: (content: any) => any,
+    onLoaded?: () => Promise<void> | void,
+}) {
+    const {t} = useI18n()
+    const toast = useToast()
+
+    const versions = ref<VersionSummary[]>([])
+    const selected = ref<number>()
+    const loaded = ref<VersionSummary & {problems?: string[]}>()
+    const content = ref<any>()
+    const snapshot = ref("")
+    const busy = ref(false)
+    const error = ref("")
+    const message = ref("")
+    const problems = ref<string[]>([])
+
+    const dirty = computed(() => content.value !== undefined && JSON.stringify(content.value) !== snapshot.value)
+
+    async function loadVersions(prefer?: "draft" | "published") {
+        const res = await gateway<{versions: VersionSummary[]}>(`${options.base()}/versions`)
+        versions.value = res.versions
+        const pick = prefer === "published"
+            ? res.versions.find(v => v.state === "PUBLISHED")
+            : res.versions.find(v => v.state === "DRAFT") ?? res.versions.find(v => v.state === "PUBLISHED")
+        await loadVersion((pick ?? res.versions[0])?.version)
+    }
+
+    async function loadVersion(v?: number) {
+        if (v === undefined) return
+        const res = await gateway<any>(`${options.base()}/versions/${v}`)
+        selected.value = v
+        loaded.value = res
+        content.value = options.normalize(clone(res[options.field]))
+        snapshot.value = JSON.stringify(content.value)
+        problems.value = res.problems ?? []
+        await options.onLoaded?.()
+    }
+
+    /** Runs a version action, reloads what it changed and shows its outcome. */
+    async function act(action: () => Promise<any>, after?: "draft" | "published" | "keep") {
+        busy.value = true
+        error.value = ""
+        message.value = ""
+        try {
+            const res = await action()
+            if (after === "keep") await loadVersion(selected.value)
+            else await loadVersions(after)
+            if (res?.message) message.value = res.message
+            if (res?.problems) problems.value = res.problems
+        } catch (e: any) {
+            error.value = e?.message ?? String(e)
+            if (e?.problems?.length) problems.value = e.problems
+        } finally {
+            busy.value = false
+        }
+    }
+
+    async function ask(message: string): Promise<boolean> {
+        let ok = false
+        await toast.confirm(message, async () => ok = true)
+        return ok
+    }
+
+    const leaveConfirmed = async () => !dirty.value || await ask(t("cr_designer.confirm_leave"))
+    const versionUrl = () => `${options.base()}/versions/${selected.value}`
+    const confirmThen = async (key: string, run: () => Promise<void>) => {
+        if (await ask(t(key, {version: selected.value}))) await run()
+    }
+
+    const handlers = {
+        select: async (v: number) => {
+            if (await leaveConfirmed()) await act(() => loadVersion(v), "keep")
+        },
+        draft: () => act(() => gateway(`${options.base()}/versions`, {method: "POST", json: {from_version: selected.value}}), "draft"),
+        save: () => act(async () => {
+            const res = await gateway<{problems: string[]}>(versionUrl(), {
+                method: "PUT", json: {[options.field]: content.value, revision: loaded.value?.revision},
+            })
+            return {...res, message: t(res.problems.length ? "cr_designer.saved_with_problems" : "cr_designer.saved")}
+        }, "keep"),
+        publish: () => confirmThen("cr_designer.confirm_publish", () => act(() => gateway(`${versionUrl()}/publish`, {method: "POST"}))),
+        discard: () => confirmThen("cr_designer.confirm_discard", () => act(() => gateway(versionUrl(), {method: "DELETE"}), "published")),
+        retire: () => confirmThen("cr_designer.confirm_retire", () => act(() => gateway(`${versionUrl()}/retire`, {method: "POST"}))),
+    }
+
+    onBeforeRouteLeave(leaveConfirmed)
+
+    return {versions, selected, loaded, content, busy, error, message, problems, dirty, loadVersions, leaveConfirmed, ask, handlers}
+}
