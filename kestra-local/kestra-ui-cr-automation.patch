+            <section class="order-card">
+                <h3>
+                    {{ childId ? $t("cr_order.child_continue", {child: childId, cr: child?.cr_name ?? ""}) : $t("cr_order.continue") }}
+                </h3>
+                <p v-if="!next" class="order-hint">{{ $t("loading") }}</p>
+                <p v-else-if="!next.continuable" class="order-hint">{{ next.reason }}</p>
+                <p v-else-if="!next.can_execute" class="order-hint">{{ $t("cr_order.view_only", {role: role}) }}</p>
+                <p v-else-if="!next.steps.length" class="order-hint">{{ $t("cr_order.no_step_now") }}</p>
+                <template v-else>
+                    <div v-for="step in next.steps" :key="step.id" class="order-action">
+                        <h4>{{ step.label }}</h4>
+                        <p v-if="step.description" class="order-hint">{{ step.description }}</p>
+                        <div v-for="input in step.inputs" :key="input.name" class="order-input">
+                            <template v-if="input.type === 'BOOL'">
+                                <label class="order-check">
+                                    <input v-model="form[step.id].values[input.name]" type="checkbox">
+                                    {{ input.label }}
+                                </label>
+                            </template>
+                            <template v-else>
+                                <span class="order-label">{{ input.label }}{{ input.required ? " *" : "" }}</span>
+                                <input v-if="input.type === 'STRING'" v-model="form[step.id].values[input.name]" type="text" class="order-select">
+                                <select v-else-if="input.type === 'SELECT'" v-model="form[step.id].values[input.name]" class="order-select">
+                                    <option v-for="o in input.options" :key="o.value" :value="o.value">
+                                        {{ o.label }}
+                                    </option>
+                                </select>
+                                <template v-else-if="input.type === 'MULTISELECT'">
+                                    <label v-if="input.all_value" class="order-check">
+                                        <input v-model="form[step.id].all[input.name]" type="checkbox">
+                                        {{ $t("cr_order.all_values", {count: input.options.length}) }}
+                                    </label>
+                                    <label v-for="o in input.options" :key="o.value" class="order-check order-node-choice">
+                                        <input
+                                            v-model="form[step.id].values[input.name]"
+                                            type="checkbox"
+                                            :value="o.value"
+                                            :disabled="form[step.id].all[input.name]"
+                                        >
+                                        {{ o.label }}
+                                    </label>
+                                </template>
+                                <input
+                                    v-else-if="input.type === 'FILE'"
+                                    type="file"
+                                    @change="form[step.id].files[input.name] = ($event.target as HTMLInputElement).files?.[0]"
+                                >
+                            </template>
+                        </div>
+                        <button type="button" class="order-run" :disabled="busy" @click="runStep(step)">
+                            {{ $t("cr_order.run_step") }}
+                        </button>
+                    </div>
+                </template>
+                <p v-if="actionError" class="order-error">{{ actionError }}</p>
+            </section>
+
+            <section v-if="childId && next?.running?.length" class="order-card" data-test="order-stop">
+                <h3>{{ $t("cr_order.running_now", {child: childId}) }}</h3>
+                <p class="order-hint">{{ $t("cr_order.stop_hint") }}</p>
+                <button v-if="next.can_execute" type="button" class="order-run" :disabled="busy" data-test="stop-child" @click="stop">
+                    {{ $t("cr_order.stop") }}
+                </button>
+                <p v-if="stopError" class="order-error">{{ stopError }}</p>
+            </section>
+
+            <section v-if="next?.decisions?.length" class="order-card" data-test="order-decisions">
+                <h3>
+                    {{ $t("cr_order.decisions") }}
+                    <button type="button" class="order-link" @click="load">{{ $t("cr_order.refresh") }}</button>
+                </h3>
+                <div v-for="d in next.decisions" :key="d.decision_id" class="order-action" :data-test="`decision-${d.decision_id}`">
+                    <h4>{{ d.question }}</h4>
+                    <p class="order-hint">
+                        {{ $t("cr_order.decision_about", {child: d.child_id, node: d.node ?? "-", item: d.item ?? "-", since: d.waiting_since}) }}
+                    </p>
+                    <p v-if="d.mode === 'REPLY'" class="order-hint">{{ $t("cr_order.waiting_reply") }}</p>
+                    <template v-else-if="d.can_decide && next.can_execute">
+                        <input v-model="comments[d.decision_id]" type="text" class="order-select" :placeholder="$t('cr_order.comment')">
+                        <div class="order-options">
+                            <button v-for="o in d.options" :key="o" type="button" class="order-run" :disabled="busy" @click="decide(d, o)">
+                                {{ o }}
+                            </button>
+                        </div>
+                    </template>
+                    <p v-else class="order-hint">{{ $t("cr_order.decision_view_only") }}</p>
+                </div>
+                <p v-if="decisionError" class="order-error">{{ decisionError }}</p>
+            </section>
+
+            <section v-if="next?.auto_starts?.length" class="order-card" data-test="order-auto-starts">
+                <h3>{{ $t("cr_order.auto_starts") }}</h3>
+                <div v-for="a in next.auto_starts" :key="`${a.step_id}-${a.child_id}-${a.item}`" class="order-hint">
+                    {{ $t("cr_order.auto_start_row", {step: a.step_id, item: a.item, state: a.state}) }}
+                    <span v-if="a.message"> - {{ a.message }}</span>
+                </div>
+            </section>
+        </template>
+    </div>
+</template>
+
+<script setup lang="ts">
+    /**
+     * "Order" tab (cr_automation): the order this execution belongs to (label order_id) as the flows publish it
+     * (namespace KV ORDER_<id>), and the steps it can take now. The steps come from the gateway
+     * (/cr/api/orders/<id>/next): the process version the order is pinned to decides what is offered and which
+     * flow runs it - nothing about the process is known here. An execution of a child order (label req_id other
+     * than order_id) gets the child's steps.
+     */
+    import {computed, reactive, ref, watch} from "vue"
+    import {useRouter, useRoute} from "vue-router"
+    import {useClient} from "@kestra-io/kestra-sdk"
+    import {apiUrl} from "override/utils/route"
+    import {useExecutionsStore} from "../../stores/executions"
+    import {useI18n} from "vue-i18n"
+    import {useToast} from "../../utils/toast"
+
+    interface StepInput {name: string, type: string, label: string, required: boolean, default: any,
+                         options?: {value: string, label: string}[], all_value?: string}
+    interface Step {id: string, label: string, description?: string, inputs: StepInput[]}
+    interface Decision {decision_id: number, child_id: string, node?: string, item?: string, mode: string, question: string,
+                        options: string[], waiting_since: string, can_decide: boolean}
+    interface AutoStart {step_id: string, child_id: number, item: string, state: string, message?: string}
+    interface Next {continuable: boolean, reason?: string, can_execute: boolean, steps: Step[], decisions?: Decision[],
+                    auto_starts?: AutoStart[], running?: string[],
+                    process?: {project: string, version: number, state: string},
+                    activity?: {node_type: string, sub_activity: string, version: number, state: string, layers?: string[]}}
+    interface StepForm {values: Record<string, any>, all: Record<string, boolean>, files: Record<string, File | undefined>}
+
+    const executionsStore = useExecutionsStore()
+    const {t} = useI18n()
+    const toast = useToast()
+    const router = useRouter()
+    const route = useRoute()
+    const http = useClient()
+    const execution = computed(() => executionsStore.execution)
+
+    const label = (key: string) => execution.value?.labels?.find((l: any) => l.key === key)?.value
+    const orderId = computed(() => label("order_id"))
+    // an execution of a child order carries the child's request id, which differs from its order's
+    const childId = computed(() => {
+        const reqId = label("req_id")
+        return reqId && reqId !== orderId.value ? reqId : undefined
+    })
+    const order = ref<any>()
+    const child = computed(() => childId.value ? order.value?.children_by_id?.[childId.value] : undefined)
+    const next = ref<Next>()
+    const role = ref("")
+    const form = reactive<Record<string, StepForm>>({})
+    const loadError = ref("")
+    const busy = ref(false)
+    const actionError = ref("")
+    const decisionError = ref("")
+    const comments = reactive<Record<number, string>>({})
+
+    async function gateway(path: string, init?: RequestInit) {
+        const response = await fetch(path, {credentials: "same-origin", ...init})
+        const body = await response.json().catch(() => ({}))
+        if (!response.ok) throw new Error(body?.message ?? response.statusText)
+        return body
+    }
+
+    async function load() {
+        if (!orderId.value || !execution.value) return
+        try {
+            const kv = `${apiUrl()}/namespaces/${execution.value.namespace}/kv`
+            const query = childId.value ? `?child=${encodeURIComponent(childId.value)}` : ""
+            const [response, steps, me] = await Promise.all([
+                http.get(`${kv}/ORDER_${orderId.value}`),
+                gateway(`/cr/api/orders/${encodeURIComponent(orderId.value)}/next${query}`),
+                gateway("/cr/api/me"),
+            ])
+            order.value = response.data?.value ?? response.data
+            role.value = me.role
+            next.value = steps
+            for (const step of (steps as Next).steps) {
+                form[step.id] = form[step.id] ?? initialForm(step)
+            }
+            loadError.value = ""
+        } catch (e: any) {
+            loadError.value = "Order " + orderId.value + ": " + (e?.message ?? e)
+        }
+    }
+
+    function initialForm(step: Step): StepForm {
+        const f: StepForm = {values: {}, all: {}, files: {}}
+        for (const input of step.inputs) {
+            const def = input.default
+            if (input.type === "MULTISELECT") {
+                const list = Array.isArray(def) ? def.map(String) : []
+                f.all[input.name] = !!input.all_value && (list.length === 0 || list.includes(input.all_value))
+                f.values[input.name] = list.filter(v => v !== input.all_value)
+            } else if (input.type === "BOOL") {
+                f.values[input.name] = def === true || def === "true"
+            } else if (input.type === "SELECT") {
+                f.values[input.name] = def ?? input.options?.[0]?.value ?? ""
+            } else if (input.type !== "FILE") {
+                f.values[input.name] = def ?? ""
+            }
+        }
+        return f
+    }
+
+    async function open(executionId: string) {
+        const e: any = (await http.get(`${apiUrl()}/executions/${executionId}`)).data
+        router.push({
+            name: "executions/update",
+            params: {tenant: route.params.tenant, namespace: e.namespace, flowId: e.flowId, id: executionId},
+        })
+    }
+
+    function readBase64(file: File): Promise<string> {
+        return new Promise((resolve, reject) => {
+            const reader = new FileReader()
+            reader.onload = () => resolve(String(reader.result).split(",", 2)[1] ?? "")
+            reader.onerror = () => reject(reader.error)
+            reader.readAsDataURL(file)
+        })
+    }
+
+    async function runStep(step: Step) {
+        busy.value = true
+        actionError.value = ""
+        try {
+            const f = form[step.id]
+            const inputs: Record<string, any> = {}
+            const files: Record<string, {filename: string, base64: string}> = {}
+            for (const input of step.inputs) {
+                if (input.type === "FILE") {
+                    const file = f.files[input.name]
+                    if (file) files[input.name] = {filename: file.name, base64: await readBase64(file)}
+                } else if (input.type === "MULTISELECT") {
+                    inputs[input.name] = f.all[input.name] && input.all_value ? [input.all_value] : f.values[input.name]
+                } else {
+                    inputs[input.name] = f.values[input.name]
+                }
+            }
+            const query = childId.value ? `?child=${encodeURIComponent(childId.value)}` : ""
+            const started = await gateway(`/cr/api/orders/${encodeURIComponent(orderId.value!)}/steps/${step.id}${query}`, {
+                method: "POST",
+                headers: {"Content-Type": "application/json"},
+                body: JSON.stringify({inputs, files, request_key: crypto.randomUUID()}),
+            })
+            router.push({
+                name: "executions/update",
+                params: {tenant: route.params.tenant, namespace: started.namespace, flowId: started.flow_id, id: started.execution_id},
+            })
+        } catch (e: any) {
+            actionError.value = e?.message ?? String(e)
+        } finally {
+            busy.value = false
+        }
+    }
+
+    const stopError = ref("")
+
+    function stop() {
+        toast.confirm(t("cr_order.stop_confirm", {child: childId.value}), async () => {
+            busy.value = true
+            stopError.value = ""
+            try {
+                await gateway(`/cr/api/orders/${encodeURIComponent(orderId.value!)}/stop?child=${encodeURIComponent(childId.value!)}`, {method: "POST"})
+            } catch (e: any) {
+                stopError.value = e?.message ?? String(e)
+            } finally {
+                busy.value = false
+                await load()
+            }
+        })
+    }
+
+    async function decide(d: Decision, option: string) {
+        busy.value = true
+        decisionError.value = ""
+        try {
+            await gateway(`/cr/api/orders/${encodeURIComponent(orderId.value!)}/decisions/${d.decision_id}`, {
+                method: "POST",
+                headers: {"Content-Type": "application/json"},
+                body: JSON.stringify({decision: option, comment: comments[d.decision_id] ?? ""}),
+            })
+            await load()
+        } catch (e: any) {
+            decisionError.value = e?.message ?? String(e)
+            await load()
+        } finally {
+            busy.value = false
+        }
+    }
+
+    watch(() => [execution.value?.id, execution.value?.state?.current, orderId.value], load, {immediate: true})
+</script>
+
+<style scoped lang="scss">
+    .order {
+        display: flex;
+        flex-wrap: wrap;
+        gap: 1rem;
+        align-items: flex-start;
+    }
+
+    .order-empty, .order-hint {
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .order-empty {
+        padding: 1rem;
+    }
+
+    .order-card {
+        flex: 1 1 26rem;
+        padding: 1rem;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.5rem;
+        background: var(--ks-bg-surface);
+        color: var(--ks-text-primary);
+
+        h3 {
+            margin: 0 0 0.75rem;
+            font-size: var(--ks-font-size-lg);
+        }
+
+        h4 {
+            margin: 0 0 0.375rem;
+        }
+    }
+
+    .order-stage {
+        margin-left: 0.5rem;
+        padding: 0.125rem 0.5rem;
+        border-radius: 0.25rem;
+        background: var(--ks-bg-tag);
+        font-size: var(--ks-font-size-xs);
+
+        &.VALIDATED { color: var(--ks-text-success, #22c55e); }
+        &.INVALID { color: var(--ks-text-warning); }
+    }
+
+    dl {
+        display: grid;
+        grid-template-columns: max-content 1fr;
+        gap: 0.25rem 1rem;
+        margin: 0 0 1rem;
+        font-size: var(--ks-font-size-sm);
+
+        dt { color: var(--ks-text-secondary); }
+        dd { margin: 0; word-break: break-all; }
+    }
+
+    .order-table {
+        width: 100%;
+        border-collapse: collapse;
+        font-size: var(--ks-font-size-sm);
+
+        th, td {
+            padding: 0.375rem 0.5rem;
+            border-bottom: 1px solid var(--ks-border-default);
+            text-align: left;
+        }
+
+        th { color: var(--ks-text-secondary); }
+        a { margin-left: 0.25rem; }
+    }
+
+    .order-action {
+        display: flex;
+        flex-direction: column;
+        gap: 0.5rem;
+        padding: 0.75rem 0;
+        border-bottom: 1px solid var(--ks-border-default);
+    }
+
+    .order-input {
+        display: flex;
+        flex-direction: column;
+        gap: 0.25rem;
+    }
+
+    .order-label {
+        font-size: var(--ks-font-size-sm);
+        color: var(--ks-text-secondary);
+    }
+
+    .order-select {
+        padding: 0.375rem;
+        border: 1px solid var(--ks-border-default);
+        border-radius: 0.25rem;
+        background: var(--ks-bg-base);
+        color: var(--ks-text-primary);
+    }
+
+    .order-check {
+        display: flex;
+        gap: 0.5rem;
+        align-items: center;
+        font-size: var(--ks-font-size-sm);
+    }
+
+    .order-run {
+        align-self: flex-start;
+        padding: 0.375rem 1rem;
+        border: none;
+        border-radius: 0.25rem;
+        background: #8405ff;
+        color: var(--ks-white);
+        cursor: pointer;
+
+        &:disabled {
+            opacity: 0.5;
+            cursor: not-allowed;
+        }
+    }
+
+    .order-node {
+        color: var(--ks-text-secondary);
+        font-size: var(--ks-font-size-xs);
+    }
+
+    .order-node-choice {
+        padding-left: 1.5rem;
+    }
+
+    .order-error {
+        color: var(--ks-text-warning);
+    }
+</style>
