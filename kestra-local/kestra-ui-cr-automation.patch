+                        <KsRadio value="STANDALONE">{{ $t("cr_designer.comp_kind_STANDALONE") }}</KsRadio>
+                        <KsRadio value="WRAPPED">{{ $t("cr_designer.comp_kind_WRAPPED") }}</KsRadio>
+                    </KsRadioGroup>
