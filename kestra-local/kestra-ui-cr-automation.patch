+<template>
+    <div class="designer">
+        <div class="designer-top">
+            <KsSelect :modelValue="project" class="project-select" :placeholder="$t('cr_designer.project')" @update:model-value="selectProject">
+                <KsOption v-for="p in projects" :key="p.project" :label="p.project" :value="p.project" />
