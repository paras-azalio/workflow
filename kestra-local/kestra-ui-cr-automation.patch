+            </KsTag>
+        </div>
+        <div class="step-label">{{ data.label }}</div>
+        <div class="step-meta">{{ data.id }} → {{ data.runs?.flow ?? "?" }}</div>
+        <div v-if="conditions" class="step-meta">{{ $t("cr_designer.when") }} {{ conditions }}</div>
+        <div v-if="hooks" class="step-meta">{{ $t("cr_designer.pipelines") }}: {{ hooks }}</div>
+        <Handle type="source" :position="Position.Right" :connectable="editable" />
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed} from "vue"
+    import {Handle, Position} from "@vue-flow/core"
+
+    const props = defineProps<{data: any, selected: boolean, editable: boolean}>()
+
+    const hooks = computed(() => Object.keys(props.data.pipelines ?? {}).join(", "))
+
+    const conditions = computed(() => Object.entries(props.data.available_when ?? {})
+        .map(([path, op]: [string, any]) => {
+            const [operator, operand] = Object.entries(op ?? {})[0] ?? ["?", ""]
