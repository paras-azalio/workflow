+<template>
+    <TopNavBar :title="routeInfo.title" />
+    <section class="full-container">
+        <KsAlert v-if="error" type="error" :closable="false">
+            {{ error }}
+        </KsAlert>
+        <KsTabs v-else-if="me" :modelValue="tab" @update:model-value="selectTab">
+            <KsTabPane name="processes" :label="$t('cr_designer.processes')" lazy>
+                <ProcessDesigner :me="me" />
+            </KsTabPane>
+            <KsTabPane name="activities" :label="$t('cr_designer.activities')" lazy>
+                <ActivityDesigner :me="me" />
+            </KsTabPane>
+            <KsTabPane name="components" :label="$t('cr_designer.components')" lazy>
+                <ComponentDesigner :me="me" />
+            </KsTabPane>
+        </KsTabs>
+    </section>
+</template>
+
+<script setup lang="ts">
+    import {computed, onMounted, ref} from "vue"
+    import {useRoute, useRouter} from "vue-router"
+    import {useI18n} from "vue-i18n"
+    import useRouteContext from "../../composables/useRouteContext"
+    import TopNavBar from "../layout/TopNavBar.vue"
+    import ProcessDesigner from "./ProcessDesigner.vue"
+    import ActivityDesigner from "./ActivityDesigner.vue"
+    import ComponentDesigner from "./ComponentDesigner.vue"
+    import {gateway} from "./crApi"
+    import type {Me} from "./crApi"
+
+    const {t} = useI18n()
+    const route = useRoute()
+    const router = useRouter()
+
+    const routeInfo = computed(() => ({title: t("cr_designer.title")}))
+    useRouteContext(routeInfo)
+
+    const me = ref<Me>()
+    const error = ref("")
+    const tab = computed(() => route.params.tab === "activities" || route.params.tab === "components" ? route.params.tab : "processes")
+
+    const selectTab = (name?: string) => router.replace({name: "cr/designer", params: {...route.params, tab: name}})
+
+    onMounted(async () => {
+        try {
+            me.value = await gateway<Me>("/cr/api/me")
+        } catch (e: any) {
+            error.value = t("cr_designer.gateway_missing", {error: e?.message ?? String(e)})
+        }
+    })
+</script>
