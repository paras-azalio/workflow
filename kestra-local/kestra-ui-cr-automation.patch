+                connectable: false,
+                position: {x: stepPosition(s).x + index * (EXTRA.width + 20), y: bottom + row * (EXTRA.height + 40)},
+                data: {step: s.id, hook, index, conditions: r.conditions, widgets: r.widgets},
+            }))
+            if (boxes.length) row++
+            return boxes
+        }))
+    })
+
+    const nodes = computed(() => [
+        ...(def.value?.steps ?? []).map((s: any) => ({id: s.id, type: "step", position: stepPosition(s), data: s})),
+        ...extras.value,
+    ])
+
+    const edges = computed(() => [
+        ...(def.value?.steps ?? []).flatMap((s: any) => s.follows.map((f: string) => ({
+            id: `${f}->${s.id}`,
