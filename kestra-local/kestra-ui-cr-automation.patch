+                                    <pre class="log">{{ JSON.stringify(tryResult.result?.request ?? {}, null, 2) }}</pre>
+                                </KsCollapseItem>
+                                <KsCollapseItem :title="$t('cr_designer.comp_try_log')">
+                                    <pre class="log">{{ [...(tryResult.result?.log ?? []), ...tryResult.log].join("\n") }}</pre>
+                                </KsCollapseItem>
