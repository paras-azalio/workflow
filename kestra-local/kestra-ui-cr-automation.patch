+        <KsDrawer v-model="pipelineOpen" direction="rtl" size="85%" :title="pipelineTitle" @closed="closePipeline">
+            <PipelineEditor v-if="pipelineStep && pipelineHook" :widgets="pipelineStep.pipelines[pipelineHook]" :hook="pipelineHook" :editable="editable" />
+        </KsDrawer>
+    </div>
+</template>
+
+<script setup lang="ts">
+    import {computed, onMounted, provide, ref} from "vue"
+    import {useRoute, useRouter} from "vue-router"
+    import {useI18n} from "vue-i18n"
+    import {VueFlow, MarkerType, useVueFlow} from "@vue-flow/core"
+    import {Background} from "@vue-flow/background"
+    import {GRAPH_BACKGROUND, MIN_ZOOM} from "@kestra-io/topology"
+    import Plus from "vue-material-design-icons/Plus.vue"
+    import Delete from "vue-material-design-icons/Delete.vue"
+    import Restore from "vue-material-design-icons/Restore.vue"
+    import VersionBar from "./VersionBar.vue"
+    import StepNode from "./StepNode.vue"
+    import ExtraNode from "./ExtraNode.vue"
+    import FlowView from "./FlowView.vue"
+    import FlowWidgetPanel from "./FlowWidgetPanel.vue"
+    import type {FlowPick} from "./flowGraph"
+    import StepEditor from "./StepEditor.vue"
+    import JsonView from "./JsonView.vue"
+    import PipelineEditor from "./PipelineEditor.vue"
+    import {CALLABLES, insertWidget, normalize as normalizeWidgets, routes} from "./pipelineWidgets"
+    import type {Callables} from "./pipelineWidgets"
+    import {computeDagLayout} from "../dependencies/utils/dagLayout"
+    import {gateway, processUrl, processFlows, projectUrl, projects} from "./crApi"
+    import type {Me, FlowInfo, ProjectInfo} from "./crApi"
+    import {useDiscardGuard} from "../../composables/useDiscardGuard"
+    import {useVersioned} from "./useVersioned"
+
+    const NODE = {width: 240, height: 110}
+    const EXTRA = {width: 220, height: 110}
+
+    const props = defineProps<{me: Me}>()
+    const {t} = useI18n()
+    const route = useRoute()
+    const router = useRouter()
+    const {fitView} = useVueFlow("cr-designer")
+
+    const callables = ref<Callables>({builtins: [], components: []})
+    provide(CALLABLES, callables)
+
+    const projectList = ref<(ProjectInfo & {hidden_by?: string})[]>([])
+    const project = ref("")
+    const showDeleted = ref(false)
+    const defaultProject = ref<string>()
+    const currentProject = computed(() => projectList.value.find(p => p.project === project.value))
+
+    async function reloadProjects() {
+        const res = await projects(project.value, showDeleted.value)
+        projectList.value = res.list
+        defaultProject.value = res.defaultProject
+        if (!res.list.some(p => p.project === project.value) && res.first) await selectProject(res.first)
+    }
+
+    /** A soft delete: the project is hidden, its orders, versions and history stay, and it can be restored. */
+    async function deleteProject() {
+        if (!await ask(t("cr_designer.confirm_delete_project", {project: project.value}))) return
+        try {
+            message.value = (await gateway<{message: string}>(`${processUrl(project.value)}/delete`, {method: "POST"})).message
+            await reloadProjects()
+        } catch (e: any) {
+            error.value = e?.message ?? String(e)
+        }
+    }
+
+    async function restoreProject() {
+        try {
+            message.value = (await gateway<{message: string}>(`${processUrl(project.value)}/restore`, {method: "POST"})).message
+            await reloadProjects()
+        } catch (e: any) {
+            error.value = e?.message ?? String(e)
+        }
+    }
+    const flows = ref<FlowInfo[]>([])
+    const fields = ref<{order: string[], child: string[]}>({order: [], child: []})
+    const selectedId = ref<string>()
+    const view = ref("flow")
+    let loadedKey = ""
+    const flowPick = ref<FlowPick>()
+
+    /** A box of the Flow view in the side panel: its widget's form, or its step. */
+    function pickInFlow(pick: FlowPick) {
+        flowPick.value = pick
+        selectedId.value = pick.step
+    }
+
+    /** "+" on an arrow: the new widget goes there and its form opens. */
+    function insertInFlow(at: {step: string, hook: string, path: (string | number)[], index: number}, type: string) {
+        const step = def.value.steps.find((s: any) => s.id === at.step)
+        if (!step || !editable.value) return
+        const id = insertWidget(step, at.hook, at.path, at.index, type)
+        pickInFlow({step: at.step, hook: at.hook, widget: id})
+    }
+
+    const {versions, selected, loaded, content: def, busy, error, message, problems, dirty, loadVersions, leaveConfirmed, ask, handlers} = useVersioned({
+        base: () => processUrl(project.value),
+        field: "definition",
+        normalize,
+        onLoaded: async () => {
+            // a save reloads the same version: keep what is open; another version starts with nothing selected
+            const key = `${project.value}/${loaded.value?.version}`
+            if (key !== loadedKey) {
+                selectedId.value = undefined
+                flowPick.value = undefined
+            }
+            loadedKey = key
+            flows.value = await processFlows(String(route.params.tenant ?? "main"), def.value.namespace ?? "")
+        },
+    })
+
+    const admin = computed(() => props.me.can.admin)
+    const editable = computed(() => admin.value && loaded.value?.state === "DRAFT")
+    const selectedStep = computed(() => def.value?.steps.find((s: any) => s.id === selectedId.value))
+
+    /** Every step gets the objects the editors fill in place. */
+    function normalize(d: any) {
+        const out = d ?? {}
+        out.steps = (out.steps ?? []).map((s: any) => ({...s, inputs: s.inputs ?? {}, follows: s.follows ?? []}))
+        for (const s of out.steps) {
+            for (const hook of Object.keys(s.pipelines ?? {})) normalizeWidgets(s.pipelines[hook])
+        }
+        out.layout = out.layout ?? {}
+        return out
+    }
+
+    const pipelineOpen = ref(false)
+    const pipelineHook = ref<string>()
+    const pipelineStep = computed(() => def.value?.steps.find((s: any) => s.id === selectedId.value))
+    const pipelineTitle = computed(() => pipelineHook.value
+        ? t("cr_designer.pipeline_title", {hook: t(`cr_designer.hook_${pipelineHook.value}`), step: pipelineStep.value?.label ?? ""}) : "")
+
+    function openPipeline(hook: string) {
+        const step = pipelineStep.value
+        if (!step) return
+        step.pipelines = step.pipelines ?? {}
+        step.pipelines[hook] = step.pipelines[hook] ?? []
+        pipelineHook.value = hook
+        pipelineOpen.value = true
+    }
+
+    /** An empty pipeline is no pipeline: the flow then runs its own default. */
+    function closePipeline() {
+        const step = pipelineStep.value
+        if (step?.pipelines && pipelineHook.value && !step.pipelines[pipelineHook.value]?.length) {
+            delete step.pipelines[pipelineHook.value]
+            if (!Object.keys(step.pipelines).length) delete step.pipelines
+        }
+        pipelineHook.value = undefined
+    }
+
+    async function selectProject(p: string) {
+        if (!await leaveConfirmed()) return
+        project.value = p
+        router.replace({query: {...route.query, project: p}})
+        fields.value = await gateway<{order: string[], child: string[]}>(`${projectUrl(p)}/context-fields`).catch(() => ({order: [], child: []}))
+        callables.value = await gateway<Callables>(`${projectUrl(p)}/components`).catch(() => ({builtins: [], components: []}))
+        await loadVersions()
+    }
+
+    const creating = ref(false)
+    const newProject = ref({project: "", name: "", namespace: "", from_project: ""})
+    const createError = ref("")
+    const {guardedClose} = useDiscardGuard(() => !!(newProject.value.project || newProject.value.name || newProject.value.namespace))
+    const beforeCloseProject = (done: () => void) => guardedClose(() => {
+        closeCreate()
+        done()
+    })
+
+    function openCreate() {
+        newProject.value = {project: "", name: "", namespace: "", from_project: project.value}
+        creating.value = true
+    }
+
+    function closeCreate() {
+        creating.value = false
+        newProject.value = {project: "", name: "", namespace: "", from_project: ""}
+        createError.value = ""
+    }
+
+    /** A new project starts as a draft (a copy of another project's process, or empty) in its own namespace. */
+    async function createProject() {
+        if (!newProject.value.project || !newProject.value.namespace) return
+        try {
+            const made = await gateway<{project: string}>("/cr/api/processes", {method: "POST", json: newProject.value})
+            closeCreate()
+            projectList.value = (await projects()).list
+            await selectProject(made.project)
+        } catch (e: any) {
+            createError.value = e?.message ?? String(e)
+        }
+    }
+
+    const positions = computed(() => {
+        const steps: any[] = def.value?.steps ?? []
+        const links = steps.flatMap(s => s.follows.map((f: string) => ({source: f, target: s.id})))
+        const placed: Record<string, {x: number, y: number}> = {}
+        if (links.length) {
+            const centres = computeDagLayout(steps.map(s => s.id), links, {columnGap: NODE.width + 80, rowGap: NODE.height + 40})
+            centres.forEach((c, id) => placed[id] = {x: c.x - NODE.width / 2, y: c.y - NODE.height / 2})
+        } else {
+            let order = 0, child = 0
+            steps.forEach(s => placed[s.id] = s.scope === "CHILD"
+                ? {x: (child++) * (NODE.width + 60), y: NODE.height + 120}
+                : {x: (order++) * (NODE.width + 60), y: 0})
+        }
+        return placed
+    })
+
+    const stepPosition = (s: any) => def.value.layout[s.id] ?? positions.value[s.id] ?? {x: 0, y: 0}
+
+    /** The extra steps of each step's pipelines (one box per activity branch), below everything else, under their step. */
+    const extras = computed(() => {
+        const steps: any[] = def.value?.steps ?? []
+        const bottom = Math.max(0, ...steps.map(s => stepPosition(s).y)) + NODE.height + 80
+        let row = 0
+        return steps.flatMap(s => Object.entries(s.pipelines ?? {}).flatMap(([hook, widgets]: [string, any]) => {
+            const boxes = routes(widgets).map((r, index) => ({
