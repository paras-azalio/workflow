# Copy to .env (git-ignored) and set real values. Kestra 2.0 basic auth: the username must be an
# e-mail address; the password at least 8 characters with an upper-case letter, a lower-case letter and a number.
# KESTRA_USER / KESTRA_PASSWORD: Kestra's single technical login - only the gateway uses it.
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=ChangeMe123
POSTGRES_PASSWORD=ChangeMe123
# the scripts (deploy.sh, run.sh, status.sh) go through the gateway with KESTRA_USER / KESTRA_PASSWORD, which is
# the gateway's first admin unless GATEWAY_ADMIN_* say otherwise
KESTRA_URL=http://localhost:8080
# Gateway (users, roles, sessions): the first admin, created only while the gateway has no user at all.
# Optional - default: KESTRA_USER / KESTRA_PASSWORD. Manage further users as admin: /cr/api/users.
# GATEWAY_ADMIN_USER=admin@example.com
# GATEWAY_ADMIN_PASSWORD=
# Order folders (KV SHARED_DATA_DIR of namespace cr_automation); inside the container
SHARED_DATA_DIR=/mnt/shared_data
# Kestra OSS secrets, base64-encoded (e.g. printf '%s' 'the-password' | base64):
#   CLICR GRC REPO_PASSWORD and CLICR login M2MPASSWORD1. The values below are base64 of 'change-me'.
SECRET_CLICR_REPO_PASSWORD=Y2hhbmdlLW1l
SECRET_CLICR_M2MPASSWORD1=Y2hhbmdlLW1l
# Request store: POSTGRES_PASSWORD in base64 (printf '%s' "$POSTGRES_PASSWORD" | base64); this is ChangeMe123
SECRET_CR_DB_PASSWORD=Q2hhbmdlTWUxMjM=
